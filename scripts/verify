def fullscreen_shot_problems(chrome, windowed_png, full_png, windowed_size):
    """A windowed capture must not count as fullscreen."""
    problems = []
    if not isinstance(chrome, dict) or chrome.get("fullscreen") is not True:
        problems.append("fullscreen flag was not set")
    try:
        width = float(chrome.get("window_w") or 0)
        height = float(chrome.get("window_h") or 0)
    except (TypeError, ValueError):
        width = height = 0.0
    if (
        windowed_size
        and abs(width - windowed_size[0]) < 2.0
        and abs(height - windowed_size[1]) < 2.0
    ):
        problems.append("fullscreen window is still the windowed size")
    if (
        Path(windowed_png).is_file()
        and Path(full_png).is_file()
        and Path(windowed_png).read_bytes() == Path(full_png).read_bytes()
    ):
        problems.append("fullscreen capture matches the windowed fixture")
    return problems


def clear_layout_files():
    for name in ("geometry.json", "layout.json", "shell-layout.json", "chrome.json"):
        path = Path("/tmp/superreader-spike") / name
        if path.is_file():
            path.unlink()


def placeholder_seen(names):
    if "问问 Slowpage…" in names:
        return True
    path = Path("/tmp/superreader-spike/fonts.json")
    if not path.is_file():
        return False
    try:
        notes = json.loads(path.read_text())
    except json.JSONDecodeError:
        return False
    return any(
        isinstance(note, dict) and note.get("label") == "问问 Slowpage…" for note in notes
    )


def form_diff_self_check():
    width, height = 4, 2
    same = bytearray([10, 20, 30, 255]) * (width * height)
    other = bytearray(same)
    other[0] = 255
    raw_same = encode_png(width, height, same)
    raw_other = encode_png(width, height, other)
    got_w, got_h, got_rows = decode_png_bytes(raw_same)
    assert (got_w, got_h) == (width, height)
    _, _, other_decoded = decode_png_bytes(raw_other)
    delta = mean_channel_delta(got_rows, other_decoded, 4)
    assert 0 < delta < 0.2, delta
    assert mean_channel_delta(got_rows, got_rows, 4) == 0
    second = {
        "sidebar": 0.093,
        "header": 0.072,
        "continue": 0.206,
        "shelf": 0.651,
        "chat": 0.133,
    }
    assert not parity_passes(second)
    close = dict(second)
    close["shelf"] = 0.40
    assert parity_passes(close)
    measured = dict(MOCK_GRID)
    measured["scrolls"] = True
    measured["last_title"] = "人间词话"
    ok, _detail = geometry_detail(measured)
    assert ok
    measured["cover_w"] = 140
    off, _detail = geometry_detail(measured)
    assert not off
    measured["cover_w"] = 128
    for columns in (4, 6):
        measured["columns"] = columns
        wrong, _detail = geometry_detail(measured)
        assert not wrong, columns
    for content, columns, cover in ((266.0, 2, 112.0), (648.0, 4, 130.5), (808.0, 5, 128.0)):
        rule = grid_rule(content)
        assert rule["columns"] == columns, (content, rule)
        assert abs(rule["cover_w"] - cover) < 0.1, (content, rule)
        body = dict(rule)
        body["content_w"] = content
        ok, detail = geometry_matches(body)
        assert ok, detail
    fitted = {
        "window": [1440, 900],
        "nodes": [
            {
                "id": "cover.0",
                "kind": "cover",
                "frame": [10, 10, 128, 192],
                "intrinsic": [128, 192],
                "container": [0, 0, 800, 600],
                "ellipsis": False,
                "scroll_child": False,
            },
            {
                "id": "title",
                "kind": "text",
                "frame": [10, 210, 128, 20],
                "intrinsic": [400, 13],
                "container": [0, 0, 800, 600],
                "ellipsis": True,
                "scroll_child": True,
            },
        ],
    }
    assert clipping_report(fitted) == []
    overflow = {
        "window": [1440, 900],
        "nodes": [
            {
                "id": "cover.0",
                "kind": "cover",
                "frame": [700, 10, 128, 192],
                "intrinsic": [128, 192],
                "container": [0, 0, 800, 600],
                "ellipsis": False,
                "scroll_child": False,
            }
        ],
    }
    assert clipping_report(overflow)
    clipped = {
        "window": [1440, 900],
        "nodes": [
            {
                "id": "title",
                "kind": "text",
                "frame": [10, 10, 40, 20],
                "intrinsic": [200, 13],
                "container": [0, 0, 800, 600],
                "ellipsis": False,
                "scroll_child": False,
            }
        ],
    }
    assert any("clipped" in item for item in clipping_report(clipped))
    crossed = {
        "window": [578, 514],
        "nodes": [
            {
                "id": "sidebar.row.1",
                "kind": "sidebar-row",
                "frame": [10, 140, 200, 28],
                "intrinsic": [200, 28],
                "container": [0, 88, 220, 80],
                "ellipsis": True,
                "label": "正在读",
                "scroll_child": True,
            },
            {
                "id": "sidebar.settings",
                "kind": "sidebar-row",
                "frame": [10, 150, 200, 28],
                "intrinsic": [200, 28],
                "container": [0, 0, 220, 514],
                "ellipsis": True,
                "label": "设置",
                "scroll_child": False,
            },
        ],
    }
    assert any("overlaps" in item for item in clipping_report(crossed))
    nested = {
        "window": [578, 514],
        "nodes": [
            {
                "id": "cover.0",
                "kind": "cover",
                "frame": [40, 40, 112, 168],
                "intrinsic": [112, 168],
                "container": [0, 0, 400, 500],
                "ellipsis": False,
                "scroll_child": False,
                "plate": True,
                "plate_rgb": "C8A24C",
            },
            {
                "id": "cover.0.type.title",
                "kind": "text",
                "frame": [48, 100, 96, 15],
                "intrinsic": [80, 15],
