    def at_height(layout, width, height):
        laid = json.loads(json.dumps(layout))
        laid["window"] = [width, height]
        inset = float(laid["inset"])
        composer_inset = float(laid["composer_inset"])
        for node in laid["nodes"]:
            frame = node.get("frame")
            if not isinstance(frame, list):
                continue
            if node.get("id") == "card":
                frame[3] = height - frame[1] - inset
            elif node.get("id") == "chat":
                frame[3] = height - frame[1]
            elif node.get("id") == "composer":
                frame[1] = height - composer_inset - frame[3]
        return laid

