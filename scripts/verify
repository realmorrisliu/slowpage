    if not path.is_file():
        return {}
    try:
        body = json.loads(path.read_text())
    except json.JSONDecodeError:
        return {}
    return body if isinstance(body, dict) else {}


def archive_frame(out, label):
    dest = out / "frames"
    dest.mkdir(parents=True, exist_ok=True)
    root = Path("/tmp/superreader-spike")
    for name in ("layout.json", "chrome.json", "geometry.json", "shell-layout.json"):
        src = root / name
        if src.is_file():
            (dest / f"{label}-{name}").write_bytes(src.read_bytes())


