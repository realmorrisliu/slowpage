def run_form_fixture(out, window_tool):
    proc = subprocess.run(
        [
            cargo_bin(),
            "build",
            "--release",
            "-p",
            "spike-library",
            "--features",
            "fixture",
            "--bin",
            "library-fixture",
        ],
        cwd=SPIKES,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        tail = "\n".join((proc.stderr or proc.stdout).splitlines()[-12:])
        return [
            check("shell-form-fixture", "shell", "window", "fail", tail or "library-fixture build failed"),
            check("shell-form-parity", "shell", "window", "fail", "fixture binary did not build"),
        ]
    root = Path(tempfile.mkdtemp(prefix="superreader-form-"))
    subprocess.run(
        [str(release_bin("library-fixture")), str(root), "form"],
        check=True,
        cwd=SPIKES,
    )
    libs = FormLibraries(root)
    state = launch(
        out,
        "form-fixture",
        child_env(
            {
                "SUPERREADER_SUPPORT_DIR": str(root / "support"),
                "SPIKE_WINDOW": "1440x900",
                "SUPERREADER_FORM_FIXTURE": "1",
                "SUPERREADER_LIBRARY": str(libs.apple),
                "SUPERREADER_CALIBRE": str(libs.calibre),
                "SUPERREADER_FOLDER": str(libs.folder),
            }
        ),
        lambda names: "Pride and Prejudice" in names and "人间词话" in names,
        45,
    )
    try:
        names = state["names"]
        (out / "form-fixture-ax.txt").write_text(state["dump"])
        layout = {}
        layout_path = Path("/tmp/superreader-spike/shell-layout.json")
        if layout_path.is_file():
            try:
                layout = json.loads(layout_path.read_text())
            except json.JSONDecodeError:
                layout = {}
        card = layout.get("card") if isinstance(layout.get("card"), list) else None
        titles = [
            "Pride and Prejudice",
            "三体",
            "The Art of Computer Programming",
            "Moby-Dick",
            "朝花夕拾",
            "呐喊",
            "Walden",
            "红楼梦",
            "Middlemarch",
            "围城",
            "Meditations",
            "人间词话",
        ]
        missing = [title for title in titles if title not in names]
        blob = "\n" + "\n".join(names) + "\n"
        continue_at = blob.find("\n继续阅读\n")
        shelf_at = blob.find("\n书架\n")
        row = blob[continue_at:shelf_at] if continue_at >= 0 and shelf_at > continue_at else ""
        order_ok = (
            row.find("Pride and Prejudice") >= 0
            and row.find("三体") > row.find("Pride and Prejudice")
            and row.find("The Art of Computer Programming") > row.find("三体")
        )
        window = window_id(window_tool, state["pid"]) if state["alive"] else None
        shot = out / "form-fixture.png"
        parity_detail = "window id missing"
        parity_ok = False
        if window is not None:
            capture(window, shot)
            mock = ROOT / "docs" / "design" / "shell" / "b-rows.png"
            scores = write_region_diffs(mock, shot, out)
            parts = [f"{name} {scores[name] * 100:.1f}%" for name in FORM_REGIONS]
            parity_detail = "mean channel delta " + ", ".join(parts)
            parity_ok = (
                shot.exists()
                and (out / "side-by-side.png").exists()
                and all((out / f"overlay-{name}.png").exists() for name in FORM_REGIONS)
                and parity_passes(scores)
            )
        inset_ok = False
        inset_detail = "form-fixture.png was not captured"
        frame = form_window_frame(shot)
        if card and len(card) == 4 and frame is not None:
            left, top, width, height = [float(item) for item in card]
            sidebar_w = float(layout.get("sidebar_w") or 0)
            chat_w = float(layout.get("chat_w") or 0)
            frame_w, frame_h = frame
            gap_before_chat = (frame_w - chat_w) - (left + width)
            bottom = frame_h - (top + height)
            left_gap = left - sidebar_w
            inset_ok = (
                abs(sidebar_w - 220) <= 0.5
                and abs(chat_w - 320) <= 0.5
                and abs(left_gap - 6) <= 0.5
                and abs(top - 6) <= 0.5
                and abs(gap_before_chat - 6) <= 0.5
                and abs(bottom - 6) <= 0.5
            )
            inset_detail = (
                f"window {frame_w:.0f}x{frame_h:.0f} sidebar {sidebar_w:.0f} chat {chat_w:.0f} "
                f"card {left:.1f},{top:.1f} {width:.1f}x{height:.1f} "
                f"left {left_gap:.1f} before-chat {gap_before_chat:.1f} bottom {bottom:.1f}"
            )
        elif card and len(card) == 4:
            inset_detail = "captured window frame is missing"
        placeholder_ok = placeholder_seen(names)
        fixture_ok = (
            state["alive"] and not missing and inset_ok and order_ok and placeholder_ok
        )
        font_ok, font_detail = read_font_notes()
        geo = read_geometry()
        geo_ok, geo_detail = geometry_detail(geo)
        last = "" if not isinstance(geo, dict) else str(geo.get("last_title") or "")
        scroll_ok = bool(geo and geo.get("scrolls")) and bool(last) and last in names
        scroll_detail = (
            f"scrolls {bool(geo and geo.get('scrolls'))}, last {last or 'missing'} "
            + ("is in the tree" if last and last in names else "is not in the tree")
        )
        clip_ok, clip_detail, state = adaptive_layout(
            out, window_tool, root, libs, state, shot
        )
        return [
            check(
                "shell-fonts",
                "shell",
                "fonts.json",
                "pass" if font_ok else "fail",
                font_detail,
            ),
            check(
                "shell-form-fixture",
                "shell",
                "window",
                "pass" if fixture_ok else "fail",
                f"{inset_detail}; missing {missing or 'none'}; continue order {order_ok}",
                "form-fixture.png" if shot.exists() else None,
            ),
            check(
                "shell-form-parity",
                "shell",
                "window",
                "pass" if parity_ok else "fail",
                parity_detail,
                "side-by-side.png" if (out / "side-by-side.png").exists() else None,
            ),
            check(
                "shell-shelf-geometry",
                "shell",
                "geometry.json",
                "pass" if geo_ok else "fail",
                geo_detail,
            ),
            check(
                "shell-shelf-scroll",
                "shell",
                "geometry.json",
                "pass" if scroll_ok else "fail",
                scroll_detail,
            ),
            check(
                "shell-clip",
                "shell",
                "layout.json",
                "pass" if clip_ok else "fail",
                clip_detail,
                "form-fullscreen.png" if (out / "form-fullscreen.png").exists() else None,
            ),
        ]
    finally:
        finish_launch(state)
        shutil.rmtree(root, ignore_errors=True)


def _capture_form(out, window_tool, state, png_name):
    if not state["alive"]:
        return False
    dest = out / png_name
    deadline = time.time() + 6
    last = "window id was not listed"
    while time.time() < deadline:
        proc = state.get("proc")
        if proc is not None and proc.poll() is not None:
            state["alive"] = False
            last = "window process exited before capture"
            break
        chosen, rows, chrome = lookup_content_window(window_tool, state["pid"])
        if chosen is None:
            want = ""
            if isinstance(chrome, dict) and chrome.get("window_w") and chrome.get("window_h"):
                want = f" for {chrome.get('window_w')}x{chrome.get('window_h')}"
            last = f"no content window{want}; saw {describe_windows(rows)}"
            time.sleep(0.1)
            continue
        try:
            capture(chosen["id"], dest)
        except RuntimeError as exc:
            last = f"window {chosen['id']} {chosen['w']:.0f}x{chosen['h']:.0f} {exc}"
            time.sleep(0.1)
            continue
        if dest.exists():
            return True
        last = f"window {chosen['id']} capture wrote nothing"
        time.sleep(0.1)
    raise RuntimeError(last)


def _form_env(root, libs, extra):
    base = {
        "SUPERREADER_SUPPORT_DIR": str(root / "support"),
        "SUPERREADER_FORM_FIXTURE": "1",
        "SUPERREADER_LIBRARY": str(libs.apple),
        "SUPERREADER_CALIBRE": str(libs.calibre),
        "SUPERREADER_FOLDER": str(libs.folder),
    }
    base.update(extra)
    return child_env(base)


def _size_note(label, pid=None):
    geo = read_geometry()
    frames = read_layout_frames()
    shell = read_shell_layout()
    matched, match_detail = geometry_matches(geo)
    problems = clipping_report(frames)
    problems.extend(alignment_report(frames))
    problems.extend(available_height_report(frames, read_chrome()))
    if pid is not None:
        problems.extend(ax_overflow(pid))
    chat = shell.get("chat_w")
    shown = problems[:8]
    extra = "" if len(problems) <= 8 else f" (+{len(problems) - 8})"
    note = f"{label}: {match_detail}; chat {chat}; clip {shown or 'none'}{extra}"
    return matched and not problems, note


def png_cicp(path):
    """The PNG cICP chunk, or None when the file does not declare one."""
    try:
        data = Path(path).read_bytes()
    except OSError:
        return None
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        return None
    index = 8
    while index + 8 <= len(data):
        length = int.from_bytes(data[index : index + 4], "big")
        kind = data[index + 4 : index + 8]
        if kind == b"cICP" and length >= 4:
            return tuple(data[index + 8 : index + 12])
        index += 12 + length
        if kind == b"IEND":
            break
    return None


def _srgb_channel_to_linear(channel):
    value = channel / 255.0
    if value <= 0.04045:
        return value / 12.92
    return ((value + 0.055) / 1.055) ** 2.4


def _linear_channel_to_srgb(value):
    value = 0.0 if value < 0.0 else 1.0 if value > 1.0 else value
    if value <= 0.0031308:
        encoded = 12.92 * value
    else:
        encoded = 1.055 * (value ** (1.0 / 2.4)) - 0.055
    return int(round(encoded * 255.0))


# Display P3 D65 to sRGB D65, linear. The capture's cICP primaries are 12
# and its transfer is 13, so the bytes are P3-encoded with the sRGB curve.
_P3_TO_SRGB = (
    (1.2249401762808637, -0.22494017628086396, 0.0),
    (-0.042056954709292184, 1.0420569547092922, 0.0),
    (-0.019637554586411246, -0.07863609724428147, 1.0982735518306925),
)


def display_p3_rows_to_srgb(rows, channels):
    converted = []
    for row in rows:
        out = bytearray(row)
        width = len(row) // channels
        for x in range(width):
            offset = x * channels
            red = _srgb_channel_to_linear(row[offset])
            green = _srgb_channel_to_linear(row[offset + 1])
            blue = _srgb_channel_to_linear(row[offset + 2])
            out[offset] = _linear_channel_to_srgb(
                _P3_TO_SRGB[0][0] * red + _P3_TO_SRGB[0][1] * green + _P3_TO_SRGB[0][2] * blue
            )
            out[offset + 1] = _linear_channel_to_srgb(
                _P3_TO_SRGB[1][0] * red + _P3_TO_SRGB[1][1] * green + _P3_TO_SRGB[1][2] * blue
            )
            out[offset + 2] = _linear_channel_to_srgb(
                _P3_TO_SRGB[2][0] * red + _P3_TO_SRGB[2][1] * green + _P3_TO_SRGB[2][2] * blue
            )
        converted.append(out)
    return converted


def plate_report(layout, png):
    """Coverless plates need type frames inside the cover, ink on the face, and the token color."""
    if not isinstance(layout, dict):
        return ["layout.json was not written"]
    nodes = layout.get("nodes")
    if not isinstance(nodes, list):
        return ["no frames"]
    by_id = {node.get("id"): node for node in nodes if isinstance(node, dict)}
    problems = []
    plates = [node for node in by_id.values() if node.get("plate")]
    if not plates:
        return ["no coverless plate frames"]
    rows = None
    channels = 3
    scale = 1.0
    if png is not None and Path(png).is_file():
        try:
            image_w, _image_h, rows = decode_png_rows(png)
            channels = len(rows[0]) // image_w if rows else 3
            # screencapture writes Display P3 primaries with an sRGB transfer.
            # The raw bytes are not the sRGB token. Delta stays 2 after the
            # declared conversion. A PNG with no cICP chunk is compared raw.
            if png_cicp(png) == (12, 13, 0, 1):
                rows = display_p3_rows_to_srgb(rows, channels)
            window = layout.get("window")
            if isinstance(window, list) and window and float(window[0]) > 0:
                scale = image_w / float(window[0])
        except (OSError, ValueError, ZeroDivisionError):
            rows = None
    for plate in plates:
        name = str(plate.get("id") or "cover")
        frame = _box(plate.get("frame"))
        title = by_id.get(f"{name}.type.title")
        author = by_id.get(f"{name}.type.author")
        if frame is None or title is None or author is None:
            problems.append(f"{name} has no type")
            continue
        for kind, node in (("title", title), ("author", author)):
            inner = _box(node.get("frame"))
            if inner is None or inner[2] < 1 or inner[3] < 1 or not _contains(frame, inner):
                problems.append(f"{name} {kind} is outside the plate")
        if rows is None:
            problems.append(f"{name} plate has no type")
            continue
        face = _sample(rows, channels, scale, frame, 0.22, 0.16)
        want = str(plate.get("plate_rgb") or "")
        if face is None:
            problems.append(f"{name} face was not sampled")
        elif want and _hex_delta(face, want) > 2:
            problems.append(f"{name} face {face} vs {want}")
        if not _plate_has_ink(rows, channels, scale, frame, face):
            problems.append(f"{name} plate has no type")
    return problems


def _sample(rows, channels, scale, frame, fx, fy):
    if not rows:
        return None
    width = len(rows[0]) // channels
    height = len(rows)
    x = int((frame[0] + frame[2] * fx) * scale)
    y = int((frame[1] + frame[3] * fy) * scale)
    if x < 0 or y < 0 or y >= height or x >= width:
        return None
    pixel = rows[y][x * channels : x * channels + 3]
    if len(pixel) < 3:
        return None
    return f"#{pixel[0]:02X}{pixel[1]:02X}{pixel[2]:02X}"


def _hex_delta(got, want):
    got = got.removeprefix("#")
    want = want.removeprefix("#")
    if len(got) < 6 or len(want) < 6:
        return 255
    try:
        channels = [abs(int(got[i : i + 2], 16) - int(want[i : i + 2], 16)) for i in (0, 2, 4)]
    except ValueError:
        return 255
    return max(channels)


def _plate_has_ink(rows, channels, scale, frame, face):
    if not rows or face is None:
        return False
    width = len(rows[0]) // channels
    height = len(rows)
    base = face.removeprefix("#")
    try:
        rgb = [int(base[i : i + 2], 16) for i in (0, 2, 4)]
    except ValueError:
        return False
    left = int((frame[0] + frame[2] * 0.2) * scale)
    right = int((frame[0] + frame[2] * 0.8) * scale)
    top = int((frame[1] + frame[3] * 0.35) * scale)
    bottom = int((frame[1] + frame[3] * 0.7) * scale)
    ink = 0
    for y in range(max(0, top), min(height, bottom), 2):
        for x in range(max(0, left), min(width, right), 2):
            pixel = rows[y][x * channels : x * channels + 3]
            if len(pixel) < 3:
                continue
            if max(abs(pixel[i] - rgb[i]) for i in range(3)) > 40:
                ink += 1
                if ink >= 8:
                    return True
    return False


def cg_event_point(origin_x, origin_y, local_x, local_y, screen_h):
    """CGWindow bounds and CGEvent.location share the main display's top-left.

    screen_h is accepted so a caller cannot silently switch to the unflipped
    bottom-left space. That space is CGEventGetUnflippedLocation, not location.
    """
    del screen_h
    return origin_x + local_x, origin_y + local_y


def pixel_changes(left, right):
    if not left or not right or len(left) != len(right):
        return 0
    return sum(1 for a, b in zip(left, right) if a != b)


def wheel_source():
    """A pixel wheel with the continuous field set. Without it, AppKit reports delta 0."""
    return """
import CoreGraphics
guard CommandLine.arguments.count > 3,
      let x = Double(CommandLine.arguments[1]),
      let y = Double(CommandLine.arguments[2]),
      let dy = Int32(CommandLine.arguments[3]) else { exit(2) }
let point = CGPoint(x: x, y: y)
CGWarpMouseCursorPosition(point)
guard let event = CGEvent(scrollWheelEvent2Source: nil, units: .pixel, wheelCount: 1, wheel1: dy, wheel2: 0, wheel3: 0) else { exit(1) }
event.location = point
event.setIntegerValueField(.scrollWheelEventIsContinuous, value: 1)
event.post(tap: .cghidEventTap)
"""


def refresh_swift(binary, source, text, label):
    """Rebuild when the source changed. A leftover binary hides a new walker."""
    current = source.read_text() if source.is_file() else ""
    if binary.is_file() and current == text:
        return
    source.parent.mkdir(parents=True, exist_ok=True)
    source.write_text(text)
    proc = subprocess.run(
        ["swiftc", "-O", "-o", str(binary), str(source)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or f"{label} swiftc failed").strip())


def compile_wheel(out):
    binary = out / "wheel"
    refresh_swift(binary, out / "wheel.swift", wheel_source(), "wheel")
    return binary


def frontmost_pid():
    proc = subprocess.run(
        [
            "osascript",
            "-e",
            'tell application "System Events" to unix id of first process whose frontmost is true',
        ],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        return None
    try:
        return int((proc.stdout or "").strip())
    except ValueError:
        return None


def claim_front(pid):
    """The wheel is delivered only to the key app. Return whether this pid is front."""
    current = frontmost_pid()
    if current == pid:
        return True, current
    subprocess.run(
        [
            "osascript",
            "-e",
            f'tell application "System Events" to set frontmost of (first process whose unix id is {int(pid)}) to true',
        ],
        capture_output=True,
        text=True,
    )
    time.sleep(0.2)
    current = frontmost_pid()
    return current == pid, current


def shelf_wheel(out, window_tool, state):
    """A wheel over the shelf grid has to move pixels. Page Down is not a substitute."""
    if not state.get("alive"):
        return False, "shelf wheel had no window"
    try:
        tool = compile_wheel(out)
    except (OSError, RuntimeError) as exc:
        return False, f"shelf wheel {exc}"
    focused, front = claim_front(state["pid"])
    if not focused:
        return False, f"shelf wheel window was not key (front pid {front})"
    metrics = window_metrics(window_tool, state["pid"])
    layout = read_shell_layout()
    card = layout.get("card") if isinstance(layout.get("card"), list) else None
    if metrics is None or card is None or len(card) != 4 or "x" not in metrics:
        return False, f"shelf wheel had no grid point ({describe_windows(window_rows(window_tool, state['pid']))})"
    point_x = float(card[0]) + float(card[2]) * 0.55
    point_y = float(card[1]) + float(card[3]) * 0.72
    if "screen_h" not in metrics:
        return False, "shelf wheel had no screen point"
    screen_x, screen_y = cg_event_point(
        metrics["x"], metrics["y"], point_x, point_y, metrics["screen_h"]
    )
    window = metrics["id"]
    before = out / "shelf-wheel-before.png"
    after = out / "shelf-wheel-after.png"
    try:
        capture(window, before)
        proc = subprocess.run(
            [str(tool), str(screen_x), str(screen_y), "-220"],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            return False, proc.stderr or "wheel post failed"
        time.sleep(0.6)
        capture(window, after)
        _, _, left = decode_png_rows(before)
        _, _, right = decode_png_rows(after)
        changed = pixel_changes(left, right)
    except (OSError, RuntimeError, ValueError) as exc:
        return False, f"shelf wheel {exc}"
    if changed <= 0:
        return False, "wheel over the shelf grid changed 0 pixels"
    return True, f"wheel over the shelf grid changed {changed} pixels"


class _LiveAdaptive:
    """The Mac process, the chrome files, and the captures adaptive_layout drives."""

    def wheel(self, out, window_tool, state):
        return shelf_wheel(out, window_tool, state)

    def size_note(self, label, pid):
        return _size_note(label, pid)

    def plates(self, layout, png):
        return plate_report(layout, png)

    def read_chrome(self):
        return read_chrome()

    def read_layout(self):
        return read_layout_frames()

    def read_shell(self):
        return read_shell_layout()

    def read_geometry(self):
        return read_geometry()

    def launch(self, out, name, env, ready, timeout, watch=None):
        return launch(out, name, env, ready, timeout, watch=watch)

    def finish(self, state):
        finish_launch(state)

    def clear(self):
        clear_layout_files()

    def capture(self, out, window_tool, state, png_name):
        return _capture_form(out, window_tool, state, png_name)

    def crops(self, out, stem, png):
        save_alignment_crops(out, stem, png)

    def archive(self, out, label):
        archive_frame(out, label)

    def archive_observed(self, out, label, layout, chrome):
        dest = out / "frames"
        dest.mkdir(parents=True, exist_ok=True)
        (dest / f"{label}-layout.json").write_text(json.dumps(layout))
        (dest / f"{label}-chrome.json").write_text(json.dumps(chrome))
        root = Path("/tmp/superreader-spike")
        for name in ("geometry.json", "shell-layout.json"):
            src = root / name
            if src.is_file():
                (dest / f"{label}-{name}").write_bytes(src.read_bytes())

    def chrome_full(self):
        return _chrome_fullscreen()


def _stage_error(notes, label, exc):
    notes.append(f"{label} {type(exc).__name__}: {exc}")


def _archive_observed(io, out, label, layout, chrome):
    writer = getattr(io, "archive_observed", None)
    if writer is not None:
        writer(out, label, layout, chrome)
    else:
        io.archive(out, label)


def adaptive_layout(out, window_tool, root, libs, state, mock_shot, io=None):
    """Minimum, the 1440 mockup, and full screen.

    A failure is recorded and the later sizes still collect their artifacts.
    The combined verdict stays fail. An exception is not turned into a pass.
    """
    io = io or _LiveAdaptive()
    notes = []
    ok = True
    windowed_size = None
    try:
        wheel_ok, wheel_detail = io.wheel(out, window_tool, state)
    except Exception as exc:
        wheel_ok = False
        wheel_detail = f"shelf wheel {type(exc).__name__}: {exc}"
    notes.append(wheel_detail)
    ok = ok and wheel_ok
    try:
        matched, note = io.size_note("1440x900", state["pid"] if state.get("alive") else None)
        plate = io.plates(io.read_layout(), mock_shot)
        if plate:
            matched = False
            note += "; " + "; ".join(plate[:6])
        if not Path(mock_shot).exists():
            matched = False
            note += "; form-fixture.png missing"
        io.crops(out, "form-fixture", mock_shot)
        io.archive(out, "1440")
        notes.append(note)
        ok = ok and matched
        windowed = io.read_chrome()
        try:
            windowed_size = (float(windowed.get("window_w")), float(windowed.get("window_h")))
        except (AttributeError, TypeError, ValueError):
            windowed_size = None
    except Exception as exc:
        _stage_error(notes, "1440", exc)
        ok = False
    if not (out / "frames" / "1440-layout.json").is_file():
        try:
            io.archive(out, "1440")
        except Exception as exc:
            _stage_error(notes, "1440 archive", exc)
            ok = False
    try:
        io.finish(state)
        io.clear()
        state = io.launch(
            out,
            "form-minimum",
            _form_env(root, libs, {"SPIKE_WINDOW": f"578x{int(library_min_height())}"}),
            lambda names: "书库" in names
            and (geo := io.read_geometry())
            and abs(float(geo.get("content_w") or 0) - 266.0) <= 1.0,
            45,
        )
        try:
            if io.capture(out, window_tool, state, "form-minimum.png") is False:
                notes.append("minimum capture returned false")
                ok = False
            io.crops(out, "form-minimum", out / "form-minimum.png")
            io.archive(out, "minimum")
        except (OSError, RuntimeError) as exc:
            notes.append(f"minimum capture {type(exc).__name__}: {exc}")
            ok = False
        matched, note = io.size_note(
            f"578x{int(library_min_height())}", state["pid"] if state.get("alive") else None
        )
        shell = io.read_shell()
        if float(shell.get("chat_w") or 0) > 0.5:
            matched = False
            note += "; chat still open"
        if not (out / "form-minimum.png").exists():
            matched = False
            note += "; png missing"
        notes.append(note)
        ok = ok and matched
    except Exception as exc:
        _stage_error(notes, "minimum", exc)
        ok = False
    exit_flag = Path("/tmp/superreader-spike/fullscreen-exit")
    try:
        exit_flag.unlink(missing_ok=True)
    except OSError as exc:
        _stage_error(notes, "fullscreen", exc)
        ok = False
    transition = []
    seen_full = {"value": False}
    entered = {"ok": False}
    arm = Path("/tmp/superreader-spike/fullscreen-arm")

    def watch_transition(_started, bucket=transition):
        try:
            layout = io.read_layout()
        except Exception as exc:
            _stage_error(notes, "fullscreen watch", exc)
            return False
        chrome = {}
        chrome_error = False
        try:
            chrome = io.read_chrome() or {}
        except Exception as exc:
            chrome_error = True
            _stage_error(notes, "fullscreen watch", exc)
        if isinstance(layout, dict) and "lights" in layout and layout.get("nodes"):
            bucket.append(json.loads(json.dumps(layout)))
        if isinstance(chrome, dict) and chrome.get("fullscreen") is True:
            seen_full["value"] = True
        kind = transition_frame(layout, chrome)
        frames = out / "frames"
        try:
            if (
                not seen_full["value"]
                and enter_sample_ready(layout, chrome, windowed_size)
            ):
                _archive_observed(io, out, "fullscreen-enter", layout, chrome)
                entered["ok"] = True
                arm.parent.mkdir(parents=True, exist_ok=True)
                arm.write_text("1")
            elif chrome_error and not (frames / "fullscreen-enter-layout.json").is_file():
                io.archive(out, "fullscreen-enter")
            elif kind == "settled" and not (frames / "fullscreen-settled-layout.json").is_file():
                _archive_observed(io, out, "fullscreen-settled", layout, chrome)
        except Exception as exc:
            _stage_error(notes, "fullscreen watch", exc)
            return False
        return kind == "settled" and entered["ok"]

    try:
        io.finish(state)
        io.clear()
        arm.parent.mkdir(parents=True, exist_ok=True)
        arm.write_text("0")
        Path("/tmp/superreader-spike/bar-fullscreen").unlink(missing_ok=True)
        state = io.launch(
            out,
            "form-fullscreen",
            _form_env(
                root,
                libs,
                {"SPIKE_WINDOW": "1440x900", "SPIKE_FULLSCREEN": "1"},
            ),
            lambda names: "书库" in names and io.chrome_full(),
            45,
            watch=watch_transition,
        )
    except Exception as exc:
        _stage_error(notes, "fullscreen", exc)
        ok = False
    try:
        settled = io.read_layout()
        if isinstance(settled, dict) and "lights" in settled and settled.get("nodes"):
            transition.append(settled)
    except Exception as exc:
        _stage_error(notes, "fullscreen", exc)
        ok = False
    try:
        if io.capture(out, window_tool, state, "form-fullscreen.png") is False:
            notes.append("fullscreen capture returned false")
            ok = False
        io.crops(out, "form-fullscreen", out / "form-fullscreen.png")
        try:
            settled_layout = io.read_layout()
            settled_chrome = io.read_chrome() or {}
            if transition_frame(settled_layout, settled_chrome) == "settled":
                _archive_observed(io, out, "fullscreen-settled", settled_layout, settled_chrome)
            elif not (out / "frames" / "fullscreen-settled-layout.json").is_file():
                io.archive(out, "fullscreen-settled")
        except Exception as exc:
            notes.append(f"fullscreen settled read {type(exc).__name__}: {exc}")
            ok = False
            if not (out / "frames" / "fullscreen-settled-layout.json").is_file():
                io.archive(out, "fullscreen-settled")
    except (OSError, RuntimeError) as exc:
        notes.append(f"fullscreen capture {type(exc).__name__}: {exc}")
        ok = False
    matched, note = True, "fullscreen"
    try:
        matched, note = io.size_note("fullscreen", state["pid"] if state.get("alive") else None)
        if windowed_size is None:
            matched = False
            note += "; windowed size was not recorded"
        shot_problems = fullscreen_shot_problems(
            io.read_chrome(), mock_shot, out / "form-fullscreen.png", windowed_size
        )
        if shot_problems:
            matched = False
            note += "; " + "; ".join(shot_problems)
    except Exception as exc:
        matched = False
        note += f"; fullscreen measure {type(exc).__name__}: {exc}"
    if not (out / "form-fullscreen.png").exists():
        matched = False
        note += "; png missing"
    exit_note = ""
    left = False
    exit_reason = ""
    exit_pair = None
    try:
        exit_flag.parent.mkdir(parents=True, exist_ok=True)
        exit_flag.write_text("1")
        was_full = io.read_chrome().get("fullscreen") is True
        deadline = time.time() + 8
        while time.time() < deadline:
            layout = io.read_layout()
            if isinstance(layout, dict) and "lights" in layout and layout.get("nodes"):
                transition.append(json.loads(json.dumps(layout)))
            chrome = io.read_chrome() or {}
            pending = exit_pending(was_full, chrome, layout)
            if pending == "":
                left = True
                exit_pair = (layout, chrome)
                break
            exit_reason = pending
            time.sleep(0.15)
    except Exception as exc:
        matched = False
        exit_note += f"; fullscreen exit {type(exc).__name__}: {exc}"
    try:
        if exit_pair is not None:
            _archive_observed(io, out, "fullscreen-exit", exit_pair[0], exit_pair[1])
        else:
            io.archive(out, "fullscreen-exit")
    except Exception as exc:
        matched = False
        exit_note += f"; fullscreen-exit archive {type(exc).__name__}: {exc}"
    if not left:
        matched = False
        exit_note += "; fullscreen did not exit"
        if exit_reason:
            exit_note += f" ({exit_reason})"
    if not (out / "form-restored.png").is_file():
        try:
            if io.capture(out, window_tool, state, "form-restored.png") is False:
                matched = False
                exit_note += "; restored capture returned false"
            io.crops(out, "form-restored", out / "form-restored.png")
        except (OSError, RuntimeError) as exc:
            matched = False
            exit_note += f"; restored capture {type(exc).__name__}: {exc}"
    if not (out / "form-restored.png").is_file():
        matched = False
        exit_note += "; restored window missing"
    note += exit_note
    if len(transition) >= 2:
        jump = transition_report(transition)
        if jump:
            matched = False
            note += "; " + "; ".join(jump[:6])
    pairs = []
    for label in ("fullscreen-enter", "fullscreen-settled", "fullscreen-exit"):
        frame_dir = out / "frames"
        if not (frame_dir / f"{label}-layout.json").is_file() and not (
            frame_dir / f"{label}-chrome.json"
        ).is_file():
            matched = False
            note += f"; {label} frame missing"
            continue
        layout_path = frame_dir / f"{label}-layout.json"
        chrome_path = frame_dir / f"{label}-chrome.json"
        try:
            layout = json.loads(layout_path.read_text()) if layout_path.is_file() else None
            chrome = json.loads(chrome_path.read_text()) if chrome_path.is_file() else None
        except (OSError, json.JSONDecodeError):
            layout = chrome = None
        if isinstance(layout, dict) and isinstance(chrome, dict):
            pairs.append((label, layout, chrome))
    for item in transition_size_report(pairs):
        matched = False
        note += f"; {item}"
    enter_pair = next((item for item in pairs if item[0] == "fullscreen-enter"), None)
    if enter_pair is not None and not enter_is_windowed(enter_pair[2], windowed_size):
        matched = False
        note += "; fullscreen-enter is already fullscreen"
    try:
        arm.unlink(missing_ok=True)
    except OSError:
        pass
    notes.append(note)
    ok = ok and matched
    return ok, "; ".join(notes), state



def _chrome_fullscreen():
    path = Path("/tmp/superreader-spike/chrome.json")
    if not path.is_file():
        return False
    try:
        body = json.loads(path.read_text())
    except json.JSONDecodeError:
        return False
    if not isinstance(body, dict) or not body.get("fullscreen"):
        return False
    try:
        window_w = float(body.get("window_w") or 0)
    except (TypeError, ValueError):
        return False
    frames = read_layout_frames() or {}
    live = frames.get("window")
    if not isinstance(live, list) or not live:
        return False
    try:
        if abs(float(live[0]) - window_w) > 2.0:
            return False
    except (TypeError, ValueError):
        return False
    shell = read_shell_layout()
    try:
        sidebar = float(shell.get("sidebar_w") or 0)
        chat = float(shell.get("chat_w") or 0)
        expected = max(0.0, window_w - sidebar - chat - 12.0 - 80.0)
        content = float((read_geometry() or {}).get("content_w"))
    except (TypeError, ValueError):
        return False
    return abs(content - expected) <= 1.0


class FormLibraries:
    def __init__(self, root: Path):
        self.apple = root / "apple"
        self.calibre = root / "calibre"
        self.folder = root / "folder"


def page_centered(body):
    """The reader page is centered in the stage. The traffic-light row is not a column."""
    return content_centered(body, tol=2.0)


def content_centered(body, tol=0.5):
    try:
        x = float(body.get("page_x"))
        width = float(body.get("page_w"))
        stage = float(body.get("stage_w"))
    except (TypeError, ValueError):
        return False
    if width <= 0 or stage <= 0 or x + width > stage + 0.5:
        return False
    return abs((x + width / 2.0) - (stage / 2.0)) <= tol


def gray_strip_painted(painted):
    """A measured left column is the rejected reader strip. No column is the page."""
    try:
        width = float(painted)
    except (TypeError, ValueError):
        return False
    return width >= 1.0


def enter_sample_ready(layout, chrome, windowed_size):
    """The windowed frame fullscreen may leave from. A short content view is not it."""
    return (
        _layout_ready(layout)
        and enter_is_windowed(chrome, windowed_size)
        and not available_height_report(layout, chrome)
    )


def near_white(red, green, blue):
    return abs(red - 255) <= 1 and abs(green - 255) <= 1 and abs(blue - 255) <= 1


def band_white(width, rows):
    """The header, the footer, the side margins, and the text ground are #ffffff ±1.

    Glyphs are skipped. A cream band in any of those regions fails, including
    when the text block itself stays white.
    The left bar is #E4E4E6, so those samples start to its right.
    """
    width, rows = past_bar(width, rows)
    height = len(rows)
    if not rows or width < 40 or height < 40:
        return False, "shot too small"
    channels = len(rows[0]) // width

    def px(x, y):
        offset = x * channels
        row = rows[y]
        return row[offset], row[offset + 1], row[offset + 2]

    def ink(x, y):
        red, green, blue = px(x, y)
        return max(red, green, blue) < 160

    def glyph_edge(x, y):
        if ink(x, y):
            return True
        for dy in (-2, -1, 0, 1, 2):
            yy = y + dy
            if yy < 0 or yy >= height:
                continue
            for dx in (-2, -1, 0, 1, 2):
                xx = x + dx
                if 0 <= xx < width and ink(xx, yy):
                    return True
        return False

    regions = {
        "header": (int(width * 0.15), int(width * 0.85), int(height * 0.02), int(height * 0.12)),
        "footer": (int(width * 0.15), int(width * 0.85), int(height * 0.92), int(height * 0.985)),
        "margin-left": (int(width * 0.02), int(width * 0.08), int(height * 0.25), int(height * 0.75)),
        "margin-right": (int(width * 0.92), int(width * 0.98), int(height * 0.25), int(height * 0.75)),
        "text": (int(width * 0.35), int(width * 0.65), int(height * 0.32), int(height * 0.68)),
    }
    problems = []
    for name, (x0, x1, y0, y1) in regions.items():
        seen = 0
        bad = None
        for y in range(max(0, y0), min(height, y1), 2):
            for x in range(max(0, x0), min(width, x1), 2):
                if name in ("text", "footer") and glyph_edge(x, y):
                    continue
                red, green, blue = px(x, y)
                if (
                    name == "text"
                    and red >= 200
                    and green >= 160
                    and blue <= 210
                    and red >= blue + 30
                    and green >= blue + 20
                ):
                    continue
                seen += 1
                if not near_white(red, green, blue):
                    bad = (x, y, red, green, blue)
                    break
            if bad:
                break
        if bad:
            x, y, red, green, blue = bad
            problems.append(f"{name} {red},{green},{blue} at {x},{y}")
        elif seen < 8:
            problems.append(f"{name} empty")
    if problems:
        return False, "; ".join(problems)
    return True, "header, footer, margins, text #ffffff"


def content_ink(path):
    width, height, rows = decode_png_rows(path)
    channels = len(rows[0]) // width
    ink = 0
    for y in range(int(height * 0.15), int(height * 0.85), 3):
        row = rows[y]
        for x in range(0, width, 3):
            offset = x * channels
            if row[offset] < 80 and row[offset + 1] < 80 and row[offset + 2] < 80:
                ink += 1
    return ink


def vertical_rule(path):
    width, height, rows = decode_png_rows(path)
    channels = len(rows[0]) // width

    def px(x, y):
        offset = x * channels
        row = rows[y]
        return row[offset], row[offset + 1], row[offset + 2]

    top = int(height * 0.18)
    bot = int(height * 0.82)
    span = max(1, (bot - top) // 2)
    for x in range(6, width - 6, 2):
        streak = 0
        best = 0
        for y in range(top, bot, 2):
            red, green, blue = px(x, y)
            left = px(x - 4, y)
            right = px(x + 4, y)
            if max(red, green, blue) < 70 and min(left) > 180 and min(right) > 180:
                streak += 1
                best = max(best, streak)
            else:
                streak = 0
        if best > span // 6:
            return x
    return None


def flat_text(value):
    return re.sub(r"[\s\u00a0\u202f\u2007\u2009\u200a]+", " ", value or "")


def duplicate_blocks(plain):
    lines = [flat_text(line).strip() for line in (plain or "").splitlines()]
    lines = [line for line in lines if line]
    return [line for previous, line in zip(lines, lines[1:]) if line == previous]


def missing_source_text(plain, book):
    text = flat_text(plain)
    if book in ("pride", "styled", "plain-en", "publisher"):
        return [phrase for phrase in ("My dear Mr. Bennet", "Mr. Bennet replied", "Mrs. Long") if phrase not in text]
    if book in ("zhaohua", "plain-zh"):
        collapsed = re.sub(r"\s+", "", text)
        needle = "范愛農" if book == "zhaohua" else "客店"
        return [] if needle in collapsed else [needle]
    return []


def ratio_within(width, height, want_w, want_h):
    if height <= 0 or want_h <= 0:
        return False
    got = width / height
    want = want_w / want_h
    return abs(got - want) / want <= 0.01


class _ScriptedAdaptive:
    """A desktop stand-in. It records launches and writes one frame per size."""

    def __init__(self, fail_1440=False, fail_plates=False, always_raise=False, drop_nodes=False, blank_windowed=False, stale_minimum=False):
        self.fail_1440 = fail_1440
        self.fail_plates = fail_plates
        self.always_raise = always_raise
        self.drop_nodes = drop_nodes
        self.blank_windowed = blank_windowed
        self.stale_minimum = stale_minimum
        self._raised = False
        self._blanked = False
        self.exit_reads = 0
        self.launches = []
        self.chrome = {
            "fullscreen": False,
            "window_w": 1440,
            "window_h": 855,
            "lights_visible": True,
        }
        self.layout = _sample_layout()

    def wheel(self, out, window_tool, state):
        return True, "wheel over the shelf grid changed 12 pixels"

    def size_note(self, label, pid):
        return True, f"{label}: scripted"

    def plates(self, layout, png):
        if self.fail_plates:
            return ["cover.0 face #808B6D vs 7D8C6A"]
        return []

    def read_chrome(self):
        if self.always_raise or (self.fail_1440 and not self._raised):
            self._raised = True
            raise TypeError(
                "read_chrome() missing 2 required positional arguments: 'path' and 'started'"
            )
        if self.blank_windowed and not self._blanked:
            self._blanked = True
            return {"fullscreen": False}
        flag = Path("/tmp/superreader-spike/fullscreen-exit")
        launched = any(name == "form-fullscreen" for name, _window, _full in self.launches)
        if flag.is_file() and launched:
            self.exit_reads += 1
            if self.exit_reads >= 2:
                self.chrome = {
                    "fullscreen": False,
                    "window_w": 1440,
                    "window_h": 855,
                    "lights_visible": True,
                    "content_w": 1440,
                    "content_h": 855,
                }
                return dict(self.chrome)
        return dict(self.chrome)

    def read_layout(self):
        body = json.loads(json.dumps(self.layout))
        if self.drop_nodes and any(name == "form-fullscreen" for name, _window, _full in self.launches):
            body["nodes"] = []
            return body
        try:
            width = float(self.chrome.get("window_w"))
            height = float(self.chrome.get("window_h"))
        except (TypeError, ValueError):
            return body
        if width > 2 and height > 2:
            return layout_at_window(body, width, height)
        return body

    def read_shell(self):
        return {"chat_w": 0, "card": [226, 6, 888, 843], "sidebar_w": 220}

    def read_geometry(self):
        if self.launches and self.launches[-1][0] == "form-minimum":
            return {"content_w": 266.0, "scrolls": True, "last_title": "人间词话"}
        return {"content_w": 808.0, "scrolls": True, "last_title": "人间词话"}

    def launch(self, out, name, env, ready, timeout, watch=None):
        self.launches.append((name, env.get("SPIKE_WINDOW"), env.get("SPIKE_FULLSCREEN")))
        if name == "form-minimum":
            self.chrome = {"fullscreen": False, "window_w": 578, "window_h": 528, "lights_visible": True}
        if name == "form-fullscreen":
            self.chrome = {"fullscreen": False, "window_w": 1440, "window_h": 855, "lights_visible": True}
            if watch:
                watch(0)
            self.chrome = {
                "fullscreen": True,
                "window_w": 1800,
                "window_h": 1125,
                "lights_visible": False,
            }
            if watch:
                watch(0)
        names = ["书库", "Pride and Prejudice", "人间词话"]
        if ready is not None and not ready(names):
            raise RuntimeError(f"{name} ready predicate rejected the scripted window")
        return {"alive": True, "pid": 7, "names": names, "proc": None, "dump": "", "started": 0}

    def finish(self, state):
        return None

    def clear(self):
        return None

    def capture(self, out, window_tool, state, png_name):
        color = {
            "form-minimum.png": (1, 2, 3),
            "form-fullscreen.png": (9, 8, 7),
            "form-restored.png": (4, 5, 6),
        }.get(png_name, (7, 7, 7))
        if png_name == "form-minimum.png" and self.stale_minimum:
            return False
        dest = out / png_name
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(encode_png(4, 2, bytes([*color, 255]) * 8))
        return True

    def crops(self, out, stem, png):
        return None

    def archive(self, out, label):
        dest = out / "frames"
        dest.mkdir(parents=True, exist_ok=True)
        (dest / f"{label}-chrome.json").write_text(json.dumps(self.chrome))
        (dest / f"{label}-layout.json").write_text(json.dumps(self.read_layout()))

    def chrome_full(self):
        return self.chrome.get("fullscreen") is True and float(self.chrome.get("window_w") or 0) > 1500


def _top_signatures(tree):
    found = {}
    dupes = []
    for node in tree.body:
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        positional = [arg.arg for arg in node.args.args]
        required = len(positional) - len(node.args.defaults)
        sig = {
            "line": node.lineno,
            "names": positional,
            "required": required,
            "total": len(positional),
            "vararg": node.args.vararg is not None,
            "kw_required": [
                arg.arg
                for arg, default in zip(node.args.kwonlyargs, node.args.kw_defaults)
                if default is None
            ],
        }
        if node.name in found:
            dupes.append(
                f"{node.name} defined at line {found[node.name]['line']} and line {node.lineno}"
            )
        found[node.name] = sig
    return found, dupes


def _call_mismatches(tree, found):
    problems = []

    class Visit(ast.NodeVisitor):
        def __init__(self):
            self.shadow = [set()]

        def visit_FunctionDef(self, node):
            local = {arg.arg for arg in node.args.args + node.args.kwonlyargs + node.args.posonlyargs}
            if node.args.vararg is not None:
                local.add(node.args.vararg.arg)
            if node.args.kwarg is not None:
                local.add(node.args.kwarg.arg)
            for child in ast.iter_child_nodes(node):
                if isinstance(child, ast.FunctionDef):
                    local.add(child.name)
                elif isinstance(child, ast.Assign):
                    for target in child.targets:
                        if isinstance(target, ast.Name):
                            local.add(target.id)
            self.shadow.append(self.shadow[-1] | local)
            self.generic_visit(node)
            self.shadow.pop()

        visit_AsyncFunctionDef = visit_FunctionDef

        def visit_Call(self, node):
            self.generic_visit(node)
            if not isinstance(node.func, ast.Name) or node.func.id not in found:
                return
            if node.func.id in self.shadow[-1]:
                return
            if any(isinstance(arg, ast.Starred) for arg in node.args):
                return
            if any(keyword.arg is None for keyword in node.keywords):
                return
            sig = found[node.func.id]
            provided = {keyword.arg for keyword in node.keywords}
            npos = len(node.args)
            if npos > sig["total"] and not sig["vararg"]:
                problems.append(
                    f"{node.func.id} line {node.lineno} passes {npos} positional arguments, "
                    f"definition at line {sig['line']} accepts {sig['total']}"
                )
                return
            filled = set(sig["names"][:npos]) | (provided & set(sig["names"]))
            missing = [name for name in sig["names"][: sig["required"]] if name not in filled]
            missing += [name for name in sig["kw_required"] if name not in provided]
            if missing:
                problems.append(
                    f"{node.func.id} line {node.lineno} is missing {', '.join(missing)}, "
                    f"definition at line {sig['line']}"
                )

    Visit().visit(tree)
    return problems


def signature_problems(source):
    tree = ast.parse(source)
    found, dupes = _top_signatures(tree)
    return dupes + _call_mismatches(tree, found)


def self_test():
    form_diff_self_check()
    left, right = light_gaps(12.0, 70.0, 0.0, 82.0)
    assert abs(left - right) <= 0.5
    column_w, column_h = 60, 20
    column = bytearray([243, 238, 228, 255]) * (column_w * column_h)
    for y in range(column_h):
        for x in range(20):
            offset = (y * column_w + x) * 4
            column[offset : offset + 4] = bytes((228, 228, 230, 255))
    got_w, _got_h, column_rows = decode_png_bytes(encode_png(column_w, column_h, column))
    assert abs(bar_column_pt(got_w, column_rows, 30.0) - 10.0) < 0.01
    assert page_centered({"page_x": 295.5, "page_w": 509.0, "stage_w": 1100.0, "bar_w": 78.0})
    assert not page_centered({"page_x": 399.0, "page_w": 400.0, "stage_w": 1100.0, "bar_w": 98.0})
    assert not page_centered({"page_x": 98.0, "page_w": 400.0, "stage_w": 1100.0, "bar_w": 98.0})
    assert page_centered({"page_x": 52.0, "page_w": 518.0, "stage_w": 622.0})
    assert not gray_strip_painted(None)
    assert not gray_strip_painted(0.0)
    assert gray_strip_painted(78.0)
    placed, _detail = icon_placement({
        "icon_frame": {"x": 106.0, "y": 17.0, "w": 18.0, "h": 18.0},
        "close": {"x": 18.0, "y": 18.0, "w": 16.0, "h": 16.0},
        "miniaturize": {"x": 41.0, "y": 18.0, "w": 16.0, "h": 16.0},
        "zoom": {"x": 64.0, "y": 18.0, "w": 16.0, "h": 16.0},
    })
    assert placed, _detail
    blocked, _detail = icon_placement({
        "icon_frame": {"x": 70.0, "y": 17.0, "w": 18.0, "h": 18.0},
        "close": {"x": 18.0, "y": 18.0, "w": 16.0, "h": 16.0},
        "miniaturize": {"x": 41.0, "y": 18.0, "w": 16.0, "h": 16.0},
        "zoom": {"x": 64.0, "y": 18.0, "w": 16.0, "h": 16.0},
    })
    assert not blocked
    page_w, page_h = 20, 12
    shifted = bytearray([255, 255, 255, 255]) * (40 * page_h)
    plain = bytearray([255, 255, 255, 255]) * (40 * page_h)
    for y in range(page_h):
        for x in range(8):
            shifted[(y * 40 + x) * 4 : (y * 40 + x) * 4 + 3] = bytes((228, 228, 230))
    shifted[(6 * 40 + 18) * 4 : (6 * 40 + 18) * 4 + 3] = bytes((10, 10, 10))
    plain[(6 * 40 + 12) * 4 : (6 * 40 + 12) * 4 + 3] = bytes((10, 10, 10))
    with tempfile.TemporaryDirectory() as tmp:
        left_png = Path(tmp) / "left.png"
        right_png = Path(tmp) / "right.png"
        left_png.write_bytes(encode_png(40, page_h, shifted))
        right_png.write_bytes(encode_png(40, page_h, plain))
        left_box = {"stage_w": 40, "page_x": 10, "page_y": 0, "page_w": page_w, "page_h": page_h}
        right_box = {"stage_w": 40, "page_x": 4, "page_y": 0, "page_w": page_w, "page_h": page_h}
        assert page_pixel_diff(left_png, left_box, right_png, right_box) == 0
        plain[(6 * 40 + 12) * 4 : (6 * 40 + 12) * 4 + 3] = bytes((20, 20, 20))
        right_png.write_bytes(encode_png(40, page_h, plain))
        assert page_pixel_diff(left_png, left_box, right_png, right_box) == 1
        wide = 80
        cornered = bytearray([255, 255, 255, 255]) * (wide * wide)
        plain_page = bytearray([255, 255, 255, 255]) * (wide * wide)
        cornered[(wide - 1) * wide * 4 + (wide - 1) * 4 : (wide - 1) * wide * 4 + wide * 4] = bytes(
            (0, 0, 0, 0)
        )
        box = {"stage_w": wide, "page_x": 0, "page_y": 0, "page_w": wide, "page_h": wide}
        shifted_box = {"stage_w": wide, "page_x": 0, "page_y": 0, "page_w": wide, "page_h": wide}
        corner_png = Path(tmp) / "corner.png"
        plain_png = Path(tmp) / "plain.png"
        corner_png.write_bytes(encode_png(wide, wide, cornered))
        plain_png.write_bytes(encode_png(wide, wide, plain_page))
        assert page_pixel_diff(corner_png, box, plain_png, shifted_box) == 0
        cornered[(40 * wide + 40) * 4 : (40 * wide + 40) * 4 + 3] = bytes((10, 10, 10))
        corner_png.write_bytes(encode_png(wide, wide, cornered))
        assert page_pixel_diff(corner_png, box, plain_png, shifted_box) == 1
        tall = 100
        footer_pt = 20.0
        paper = bytearray([255, 255, 255, 255]) * (tall * tall)
        footer = bytearray(paper)
        footer_y = tall - int(footer_pt) + 4
        footer[(footer_y * tall + 40) * 4 : (footer_y * tall + 40) * 4 + 3] = bytes((90, 90, 90))
        foot_box = {"stage_w": tall, "page_x": 0, "page_y": 0, "page_w": tall, "page_h": tall}
        paper_png = Path(tmp) / "paper.png"
        footer_png = Path(tmp) / "footer.png"
        paper_png.write_bytes(encode_png(tall, tall, paper))
        footer_png.write_bytes(encode_png(tall, tall, footer))
        assert page_pixel_diff(footer_png, foot_box, paper_png, foot_box) == 1
        assert bold_off_page_diff(footer_png, foot_box, paper_png, foot_box, footer_pt) == 0
        footer[(40 * tall + 40) * 4 : (40 * tall + 40) * 4 + 3] = bytes((10, 10, 10))
        footer_png.write_bytes(encode_png(tall, tall, footer))
        assert bold_off_page_diff(footer_png, foot_box, paper_png, foot_box, footer_pt) == 1
    gap_w, gap_h = 100, 80
    gap = bytearray([255, 255, 255, 255]) * (gap_w * gap_h)
    gap_chrome = {"stage_w": 50, "page_x": 0, "page_y": 0, "page_w": 50}
    gap_web = {"last_bottom": 20, "footer_text_top": 30}
    with tempfile.TemporaryDirectory() as tmp:
        gap_png = Path(tmp) / "gap.png"
        gap_png.write_bytes(encode_png(gap_w, gap_h, gap))
