def image_channels(rows, width):
    if width <= 0 or not rows:
        return 0
    return len(rows[0]) // width


def crop_box(rows, width, channels, box):
    x, y, w, h = box
    x = max(0, min(width - 1, x))
    y = max(0, min(len(rows) - 1, y))
    w = max(1, min(width - x, w))
    h = max(1, min(len(rows) - y, h))
    out = []
    for row_y in range(y, y + h):
        start = x * channels
        out.append(rows[row_y][start : start + w * channels])
    return out, w, h


def scale_rows(rows, width, channels, dst_w, dst_h):
    src_h = len(rows)
    dst_w = max(1, dst_w)
    dst_h = max(1, dst_h)
    out = []
    for y in range(dst_h):
        sy = min(src_h - 1, int(y * src_h / dst_h))
        src = rows[sy]
        row = bytearray(dst_w * channels)
        for x in range(dst_w):
            sx = min(width - 1, int(x * width / dst_w))
            src_i = sx * channels
            dst_i = x * channels
            row[dst_i : dst_i + channels] = src[src_i : src_i + channels]
        out.append(row)
    return out


def mean_channel_delta(left, right, channels):
    if not left or not right or len(left) != len(right):
        return 1.0
    total = 0
    count = 0
    for a, b in zip(left, right):
        n = min(len(a), len(b))
        step = channels if channels else 1
        for i in range(0, n - step + 1, step):
            for c in range(min(3, step)):
                total += abs(a[i + c] - b[i + c])
            count += 1
    if count == 0:
        return 1.0
    return (total / count) / 255.0


def tint_overlay(base, other, channels):
    painted = []
    for a, b in zip(base, other):
        row = bytearray(a)
        n = min(len(a), len(b))
        step = channels if channels else 4
        for i in range(0, n - step + 1, step):
            delta = max(abs(a[i] - b[i]), abs(a[i + 1] - b[i + 1]), abs(a[i + 2] - b[i + 2]))
            if delta > 28:
                row[i] = min(255, a[i] // 2 + 160)
                row[i + 1] = a[i + 1] // 3
                row[i + 2] = a[i + 2] // 3
        painted.append(row)
    return painted


def rows_to_rgba(rows, width, channels):
    flat = bytearray()
    for row in rows:
        if channels == 4:
            flat.extend(row[: width * 4])
        else:
            for x in range(width):
                i = x * channels
                flat.extend(row[i : i + 3])
                flat.append(255)
    return flat


def point_box(box, image_w, image_h):
    x, y, w, h = box
    sx = image_w / FORM_W
    sy = image_h / FORM_H
    return (
        int(round(x * sx)),
        int(round(y * sy)),
        max(1, int(round(w * sx))),
        max(1, int(round(h * sy))),
    )


def write_region_diffs(mock_path, app_path, out):
    mock_w, mock_h, mock_rows = decode_png_rows(mock_path)
    app_w, app_h, app_rows = decode_png_rows(app_path)
    mock_c = image_channels(mock_rows, mock_w)
    app_c = image_channels(app_rows, app_w)
    side_h = 900
    mock_side = scale_rows(mock_rows, mock_w, mock_c, max(1, int(mock_w * side_h / mock_h)), side_h)
    app_side = scale_rows(app_rows, app_w, app_c, max(1, int(app_w * side_h / app_h)), side_h)
    gap = bytearray([210, 210, 214, 255]) * 8
    mock_rgba_rows = []
    app_rgba_rows = []
    for row in mock_side:
        mock_rgba_rows.append(rows_to_rgba([row], len(row) // mock_c, mock_c))
    for row in app_side:
        app_rgba_rows.append(rows_to_rgba([row], len(row) // app_c, app_c))
    side_w = len(mock_rgba_rows[0]) // 4 + 8 + len(app_rgba_rows[0]) // 4
    joined = bytearray()
    for left, right in zip(mock_rgba_rows, app_rgba_rows):
        joined.extend(left)
        joined.extend(gap)
        joined.extend(right)
    (out / "side-by-side.png").write_bytes(encode_png(side_w, side_h, joined))
    scores = {}
    for name, (mock_pts, app_pts) in FORM_REGIONS.items():
        mock_box = point_box(mock_pts, mock_w, mock_h)
        app_box = point_box(app_pts, app_w, app_h)
        mock_crop, mw, mh = crop_box(mock_rows, mock_w, mock_c, mock_box)
        app_crop, aw, ah = crop_box(app_rows, app_w, app_c, app_box)
        app_scaled = scale_rows(app_crop, aw, app_c, mw, mh)
        delta = mean_channel_delta(mock_crop, app_scaled, min(mock_c, app_c) or 3)
        scores[name] = delta
        overlay = tint_overlay(mock_crop, app_scaled, mock_c)
        flat = rows_to_rgba(overlay, mw, mock_c)
        (out / f"overlay-{name}.png").write_bytes(encode_png(mw, mh, flat))
    return scores


def read_font_notes():
    path = Path("/tmp/superreader-spike/fonts.json")
    if not path.is_file():
        return False, "fonts.json was not written from the view tree"
    try:
        notes = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        return False, str(exc)
    want = {
        "全部书籍": (26, 700),
        "12 本": (13, 400),
        "继续阅读": (15, 600),
        "书架": (15, 600),
        "Slowpage": (13, 600),
        "你的阅读助手": (11.5, 400),
        "问问 Slowpage…": (13, 400),
        "最近阅读": (12.5, 400),
    }
    found = {}
    for note in notes:
        if isinstance(note, dict) and note.get("label"):
            found.setdefault(note.get("label"), []).append(note)
    missing = []
    for label, (size, weight) in want.items():
        rows = found.get(label) or []
        if not rows:
            missing.append(label)
            continue
        if not any(
            abs(float(note.get("size") or 0) - size) <= 0.1 and int(note.get("weight") or 0) == weight
            for note in rows
        ):
            shown = ", ".join(f"{note.get('size')}/{note.get('weight')}" for note in rows)
            missing.append(f"{label} {shown}")
    if missing:
        return False, "font mismatch " + ", ".join(missing)
    return True, "fonts.json matches the view tree for the full-form labels"


def form_window_frame(shot):
    """Points of the captured window. Retina captures are twice the point size."""
    if not shot.is_file():
        return None
    try:
        image_w, image_h, _rows = decode_png_rows(shot)
    except (OSError, ValueError):
        return None
    if image_w >= 2000 and image_h >= 1000:
        return image_w / 2.0, image_h / 2.0
    if image_w >= 1000 and image_h >= 600:
        return float(image_w), float(image_h)
    return None


def parity_passes(scores):
    return all(name in scores and scores[name] <= PARITY_MAX[name] for name in PARITY_MAX)


def geometry_detail(geo):
    if not isinstance(geo, dict):
        return False, "geometry.json was not written from the view"
    bad = []
    for key, want in MOCK_GRID.items():
        got = geo.get(key)
        try:
            got_n = float(got)
            want_n = float(want)
        except (TypeError, ValueError):
            bad.append(key)
            continue
        if key == "columns":
            if got_n != want_n:
                bad.append(f"{key} {got}")
            continue
        if abs(got_n - want_n) > 1.0:
            bad.append(f"{key} {got}")
    if not geo.get("scrolls"):
        bad.append("scrolls")
    last = str(geo.get("last_title") or "")
    if not last:
        bad.append("last_title")
    if bad:
        return False, "geometry " + ", ".join(bad)
    return True, (
        f"cover {geo.get('cover_w')}x{geo.get('cover_h')} "
        f"gap {geo.get('column_gap')}/{geo.get('row_gap')} "
        f"caption {geo.get('caption_h')} columns {geo.get('columns')} "
        f"scrolls, last {last}"
    )


def read_geometry():
    path = Path("/tmp/superreader-spike/geometry.json")
    if not path.is_file():
        return None
    try:
        body = json.loads(path.read_text())
    except json.JSONDecodeError:
        return None
    return body if isinstance(body, dict) else None


COVER_MIN_W = 112.0
COVER_MAX_W = 168.0
COLUMN_GAP = 42.0
CLIP_TOL = 0.5
GEOM_TOL = 1.0


def grid_rule(content_w):
    """The shelf rule. Columns fill from a 112-point cover; width stretches to 168."""
    try:
        usable = float(content_w)
    except (TypeError, ValueError):
        usable = 0.0
    if usable != usable or usable < 0.0:
        usable = 0.0
    columns = int((usable + COLUMN_GAP) // (COVER_MIN_W + COLUMN_GAP))
    if columns < 1:
        columns = 1
    raw = (usable - (columns - 1) * COLUMN_GAP) / columns
    cover_w = usable if usable < COVER_MIN_W else min(raw, COVER_MAX_W)
    if cover_w < 0.0:
        cover_w = 0.0
    return {
        "columns": columns,
        "cover_w": cover_w,
        "cover_h": cover_w * 3.0 / 2.0,
        "column_gap": 0.0 if columns <= 1 else COLUMN_GAP,
        "row_gap": 28.0,
        "caption_h": 42.0,
    }


def geometry_matches(geo, content_w=None):
    """True when geometry.json is the rule's output at this content width."""
    if not isinstance(geo, dict):
        return False, "geometry.json was not written from the view"
    if content_w is None:
        content_w = geo.get("content_w")
    try:
        width = float(content_w)
    except (TypeError, ValueError):
        return False, "content_w missing"
    want = grid_rule(width)
    bad = []
    for key, value in want.items():
        try:
            got = float(geo.get(key))
        except (TypeError, ValueError):
            bad.append(key)
            continue
        if key == "columns":
            if got != value:
                bad.append(f"columns {got}")
        elif abs(got - value) > GEOM_TOL:
            bad.append(f"{key} {got}")
    if bad:
        return False, f"content {width:.1f} " + ", ".join(bad)
    return True, (
        f"content {width:.1f} columns {want['columns']} "
        f"cover {want['cover_w']:.1f}x{want['cover_h']:.1f} gap {want['column_gap']:.0f}"
    )


ALIGN_TOL = 0.5
CARD_CORNER = 12.0


def continue_card(node_id):
    """A continue card is continue.0, not the continue.section label."""
    if not isinstance(node_id, str) or not node_id.startswith("continue."):
        return False
    return node_id.split(".", 1)[1].isdigit()


def _mid(frame):
    return frame[1] + frame[3] / 2.0


def _bottom(frame):
    return frame[1] + frame[3]


def available_height_report(layout, chrome):
    """The shelf and the chat use the window, leaving the approved bottom gap.

    The layout file's own window is derived from the card, so it cannot see a
    band under both panels. The window frame and the content view are the
    root. Tolerance is the same 0.5pt as the inset token.
    """
    if not isinstance(layout, dict) or not isinstance(chrome, dict):
        return ["available height missing"]
    nodes = layout.get("nodes")
    if not isinstance(nodes, list):
        return ["available height missing"]
    by_id = {
        node.get("id"): node
        for node in nodes
        if isinstance(node, dict) and isinstance(node.get("id"), str)
    }

    def box(node_id):
        node = by_id.get(node_id)
        if node is None:
            return None
        return _box(node.get("frame"))

    try:
        window_h = float(chrome["window_h"])
        window_w = float(chrome["window_w"])
        layout_w = float(layout["window"][0])
        layout_h = float(layout["window"][1])
        inset = float(layout["inset"])
        composer_inset = float(layout["composer_inset"])
    except (KeyError, TypeError, ValueError, IndexError):
        return ["available height missing"]
    problems = []
    if abs(layout_w - window_w) > ALIGN_TOL or abs(layout_h - window_h) > ALIGN_TOL:
        problems.append(
            f"layout {layout_w:.0f}x{layout_h:.0f} window {window_w:.0f}x{window_h:.0f}"
        )
    if "content_w" in chrome and "content_h" in chrome:
        try:
            content_w = float(chrome["content_w"])
            content_h = float(chrome["content_h"])
        except (TypeError, ValueError):
            problems.append("content missing")
        else:
            if abs(content_w - window_w) > ALIGN_TOL or abs(content_h - window_h) > ALIGN_TOL:
                problems.append(
                    f"content {content_w:.1f}x{content_h:.1f} window {window_w:.1f}x{window_h:.1f}"
                )
    card = box("card")
    if card is None:
        problems.append("card missing")
        return problems
    card_gap = window_h - _bottom(card)
    if abs(card_gap - inset) > ALIGN_TOL:
        problems.append(f"card bottom gap {card_gap:.2f}")
    chat = box("chat")
    if chat is not None:
        chat_gap = window_h - _bottom(chat)
        if abs(chat_gap) > ALIGN_TOL:
            problems.append(f"chat bottom gap {chat_gap:.2f}")
    composer = box("composer")
    if composer is not None:
        composer_gap = window_h - _bottom(composer)
        if abs(composer_gap - composer_inset) > ALIGN_TOL:
            problems.append(f"composer bottom gap {composer_gap:.2f}")
    return problems


def layout_at_window(layout, width, height):
    """Copy a layout onto a window, keeping the card, chat, and composer gaps."""
    laid = json.loads(json.dumps(layout))
    laid["window"] = [width, height]
    try:
        inset = float(laid["inset"])
        composer_inset = float(laid["composer_inset"])
    except (KeyError, TypeError, ValueError):
        return laid
    for node in laid.get("nodes") or []:
        frame = node.get("frame")
        if not isinstance(frame, list) or len(frame) < 4:
            continue
        if node.get("id") == "card":
            frame[3] = height - frame[1] - inset
        elif node.get("id") == "chat":
            frame[3] = height - frame[1]
        elif node.get("id") == "composer":
            frame[1] = height - composer_inset - frame[3]
        elif node.get("id") == "sidebar":
            frame[3] = height - frame[1]
    return laid


def _layout_ready(layout):
    return isinstance(layout, dict) and "lights" in layout and bool(layout.get("nodes"))


def transition_frame(layout, chrome):
    """Classify one native sample. A fullscreen sample is settled only when
    the layout window matches the NSWindow. A short layout under a tall
    window is not the enter frame and not the settled frame.
    """
    if not _layout_ready(layout) or not isinstance(chrome, dict):
        return None
    if "fullscreen" not in chrome and "window_w" not in chrome:
        return "enter"
    if available_height_report(layout, chrome):
        return None
    if chrome.get("fullscreen") is True:
        return "settled"
    return "enter"


def enter_is_windowed(chrome, windowed_size):
    """The enter frame is a non-fullscreen NSWindow.

    When the windowed size was recorded, the frame has to match it within
    0.5pt. A fullscreen sample is never the enter frame, even if a later
    reread would have the same layout.
    """
    if not isinstance(chrome, dict) or chrome.get("fullscreen") is not False:
        return False
    try:
        width = float(chrome["window_w"])
        height = float(chrome["window_h"])
    except (KeyError, TypeError, ValueError):
        return False
    if width <= 2 or height <= 2:
        return False
    if not windowed_size:
        return True
    try:
        want_w = float(windowed_size[0])
        want_h = float(windowed_size[1])
    except (TypeError, ValueError, IndexError):
        return False
    return abs(width - want_w) <= ALIGN_TOL and abs(height - want_h) <= ALIGN_TOL


def record_transition(samples):
    """Fold timed samples into the enter and settled labels they actually prove."""
    enter = settled = None
    seen_full = False
    for chrome, layout in samples:
        if isinstance(chrome, dict) and chrome.get("fullscreen") is True:
            seen_full = True
        kind = transition_frame(layout, chrome)
        if kind == "enter" and not seen_full:
            enter = "enter"
        elif kind == "settled" and settled is None:
            settled = "settled"
    return enter, settled


def exit_pending(was_full, chrome, layout):
    """Empty when the window has left fullscreen and the layout lights match it.

    A restored NSWindow with layout lights still false is not an exit. The
    height check stays the same 0.5pt agreement as the settled frame.
    """
    if not was_full:
        return "fullscreen was not entered"
    if not isinstance(chrome, dict) or chrome.get("fullscreen") is not False:
        return "window still fullscreen"
    if not isinstance(layout, dict) or layout.get("lights") is not True:
        return "layout lights have not matched the window"
    problems = available_height_report(layout, chrome)
    if problems:
        return "layout has not matched the window (" + "; ".join(problems) + ")"
    return ""


def alignment_report(layout):
    """Centers, edges, and repeated gaps against the layout.json grid. Tolerance is 0.5pt."""
    if not isinstance(layout, dict):
        return []
    nodes = layout.get("nodes")
    if not isinstance(nodes, list):
        return ["no frames"]
    by_id = {
        node.get("id"): node
        for node in nodes
        if isinstance(node, dict) and isinstance(node.get("id"), str)
    }
    try:
        center = float(layout["chrome_center"])
        inset = float(layout["inset"])
        side_pad = float(layout["sidebar_pad_x"])
        card_pad = float(layout["card_pad_x"])
        chat_pad = float(layout["chat_pad_x"])
        corner = float(layout["window_corner"])
        composer_inset = float(layout["composer_inset"])
        composer_pad = float(layout["composer_pad"])
        traffic_bar = float(layout["traffic_bar"])
        content_top = float(layout["content_top"])
        window_w = float(layout["window"][0])
        window_h = float(layout["window"][1])
        lights = bool(layout["lights"])
    except (KeyError, TypeError, ValueError, IndexError):
        return ["alignment grid missing"]
    problems = []
    row_center = center + content_top

    def frame(node_id):
        node = by_id.get(node_id)
        if node is None:
            return None
        return _box(node.get("frame"))

    def want_center(node_id, at):
        box = frame(node_id)
        if box is None:
            problems.append(f"{node_id} missing")
            return
        delta = _mid(box) - at
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} Y {delta:+.2f}")

    chat = frame("chat")
    for node_id in (
        "sidebar.toggle",
        "toolbar",
        "toolbar.sort",
        "toolbar.view",
        "chat.head",
        "chat.avatar",
        "chat.name",
        "chat.new",
        "chat.panel",
    ):
        if node_id.startswith("chat") and chat is None:
            continue
        want_center(node_id, row_center)
    for node_id in ("traffic.close", "traffic.miniaturize", "traffic.zoom"):
        box = frame(node_id)
        if box is None or box[3] <= 8:
            continue
        if (
            box[1] < -1
            or box[1] + box[3] > window_h + 1
            or box[0] < -1
            or box[0] + box[2] > window_w + 1
        ):
            continue
        # A fullscreen window parks the buttons below the title-bar band.
        if box[1] > 48.5:
            continue
        delta = _mid(box) - center
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} Y {delta:+.2f}")
    card = frame("card")
    if card is None:
        problems.append("card missing")
        return problems
    if abs(card[1] - (inset + content_top)) > ALIGN_TOL:
        problems.append(f"card Y {card[1] - (inset + content_top):+.2f}")
    card_bottom = window_h - (card[1] + card[3])
    if abs(card_bottom - inset) > ALIGN_TOL:
        problems.append(f"card bottom {card_bottom - inset:+.2f}")
    sidebar = frame("sidebar")
    if sidebar is None:
        delta = card[0] - inset
        if abs(delta) > ALIGN_TOL:
            problems.append(f"card inset X {delta:+.2f}")
    else:
        delta = card[0] - (sidebar[0] + sidebar[2] + inset)
        if abs(delta) > ALIGN_TOL:
            problems.append(f"card inset X {delta:+.2f}")
    right = window_w - (card[0] + card[2])
    if chat is None:
        if abs(right - inset) > ALIGN_TOL:
            problems.append(f"card inset right {right - inset:+.2f}")
    else:
        delta = chat[0] - (card[0] + card[2] + inset)
        if abs(delta) > ALIGN_TOL:
            problems.append(f"chat inset X {delta:+.2f}")
        avatar = frame("chat.avatar")
        if avatar is not None:
            delta = avatar[0] - (chat[0] + chat_pad)
            if abs(delta) > ALIGN_TOL:
                problems.append(f"chat.avatar X {delta:+.2f}")
        name = frame("chat.name")
        sub = frame("chat.sub")
        if name is not None and sub is not None:
            delta = _bottom(name) - _bottom(sub)
            if abs(delta) > ALIGN_TOL:
                problems.append(f"chat.sub baseline {delta:+.2f}")
    content_x = card[0] + card_pad
    for node_id in ("shelf.header", "shelf.section", "continue.section"):
        box = frame(node_id)
        if box is None:
            continue
        delta = box[0] - content_x
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} X {delta:+.2f}")
    for node_id in ("continue.0", "cover.0"):
        box = frame(node_id)
        if box is None:
            continue
        delta = box[0] - content_x
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} X {delta:+.2f}")
    title = frame("shelf.header.title")
    count = frame("shelf.header.count")
    if title is not None and count is not None:
        delta = _bottom(title) - _bottom(count)
        if abs(delta) > ALIGN_TOL:
            problems.append(f"shelf.header.count baseline {delta:+.2f}")
    for node_id in by_id:
        row = node_id == "sidebar.settings" or (
            node_id.startswith("sidebar.row.") and node_id.count(".") == 2
        )
        if not row:
            continue
        box = frame(node_id)
        if box is None:
            continue
        delta = box[0] - side_pad
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} X {delta:+.2f}")
        if abs(box[3] - 28.0) > ALIGN_TOL:
            continue
        row_mid = _mid(box)
        for suffix in (".icon", ".label"):
            child = frame(node_id + suffix)
            if child is None:
                problems.append(f"{node_id}{suffix} missing")
                continue
            delta = _mid(child) - row_mid
            if abs(delta) > ALIGN_TOL:
                problems.append(f"{node_id}{suffix} Y {delta:+.2f}")
    for node_id in by_id:
        if not node_id.startswith("sidebar.group."):
            continue
        box = frame(node_id)
        if box is None:
            continue
        delta = box[0] - side_pad
        if abs(delta) > ALIGN_TOL:
            problems.append(f"{node_id} X {delta:+.2f}")
    covers = []
    for node_id, node in by_id.items():
        if node_id.startswith("cover.") and node_id.count(".") == 1 and node.get("kind") == "cover":
            box = frame(node_id)
            if box is not None:
                covers.append(box)
    covers.sort(key=lambda box: (box[1], box[0]))
    if len(covers) >= 2:
        row = [box for box in covers if abs(box[1] - covers[0][1]) <= ALIGN_TOL]
        gaps = [right[0] - (left[0] + left[2]) for left, right in zip(row, row[1:])]
        if gaps and any(abs(gap - gaps[0]) > ALIGN_TOL for gap in gaps[1:]):
            problems.append(f"shelf column gap {gaps[-1] - gaps[0]:+.2f}")
    continues = []
    for node_id in by_id:
        if continue_card(node_id):
            box = frame(node_id)
            if box is not None:
                continues.append(box)
    continues.sort(key=lambda box: box[0])
    if len(continues) >= 2:
        gaps = [right[0] - (left[0] + left[2]) for left, right in zip(continues, continues[1:])]
        if any(abs(gap - gaps[0]) > ALIGN_TOL for gap in gaps[1:]):
            problems.append(f"continue gap {gaps[-1] - gaps[0]:+.2f}")
    caption = frame("cover.0.title")
    if card is not None and caption is not None:
        clearance = (card[1] + card[3]) - (caption[1] + caption[3])
        if clearance + ALIGN_TOL < CARD_CORNER:
            problems.append(f"cover caption clearance {clearance:.2f}")
    cover = frame("continue.0.cover")
    title = frame("continue.0.title")
    if cover is not None and title is not None:
        delta = title[1] - cover[1]
        if abs(delta) > ALIGN_TOL:
            problems.append(f"continue.0.title Y {delta:+.2f}")
    search = frame("sidebar.search")
    if search is not None:
        delta = search[0] - side_pad
        if abs(delta) > ALIGN_TOL:
            problems.append(f"sidebar.search X {delta:+.2f}")
    if sidebar is not None:
        settings = frame("sidebar.settings")
        if settings is None:
            problems.append("sidebar.settings missing")
        else:
            gap = window_h - (settings[1] + settings[3])
            delta = gap - corner
            if abs(delta) > ALIGN_TOL:
                problems.append(f"sidebar.settings bottom {delta:+.2f}")
    composer = frame("composer")
    if composer is not None:
        right_gap = window_w - (composer[0] + composer[2])
        bottom_gap = window_h - (composer[1] + composer[3])
        if abs(right_gap - composer_inset) > ALIGN_TOL:
            problems.append(f"composer right {right_gap - composer_inset:+.2f}")
        if abs(bottom_gap - composer_inset) > ALIGN_TOL:
            problems.append(f"composer bottom {bottom_gap - composer_inset:+.2f}")
        if composer_inset + ALIGN_TOL < corner:
            problems.append(f"composer inset {composer_inset - corner:+.2f}")
        placeholder = frame("composer.placeholder")
        attach = frame("composer.attach")
        send = frame("composer.send")
        chip = frame("composer.chip")
        if placeholder is None or attach is None or send is None:
            problems.append("composer controls missing")
        else:
            if abs(placeholder[0] - attach[0]) > ALIGN_TOL:
                problems.append(f"composer.attach X {attach[0] - placeholder[0]:+.2f}")
            if abs(placeholder[0] - (composer[0] + composer_pad)) > ALIGN_TOL:
                problems.append(
                    f"composer.placeholder X {placeholder[0] - (composer[0] + composer_pad):+.2f}"
                )
            if abs(placeholder[1] - (composer[1] + composer_pad)) > ALIGN_TOL:
                problems.append(
                    f"composer.placeholder Y {placeholder[1] - (composer[1] + composer_pad):+.2f}"
                )
            send_gap = (composer[0] + composer[2]) - (send[0] + send[2])
            if abs(send_gap - composer_pad) > ALIGN_TOL:
                problems.append(f"composer.send X {send_gap - composer_pad:+.2f}")
            row_mid = _mid(attach)
            for node_id, box in (("composer.send", send), ("composer.chip", chip)):
                if box is None:
                    continue
                delta = _mid(box) - row_mid
                if abs(delta) > ALIGN_TOL:
                    problems.append(f"{node_id} Y {delta:+.2f}")
                if abs(box[3] - attach[3]) > ALIGN_TOL:
                    problems.append(f"{node_id} height {box[3] - attach[3]:+.2f}")
            if chip is not None:
                raw = by_id.get("composer.chip") or {}
                try:
                    natural = float(raw.get("intrinsic")[0])
                except (TypeError, ValueError, IndexError):
                    natural = None
                if natural is not None and chip[2] > natural + ALIGN_TOL:
                    problems.append(f"composer.chip stretches {chip[2] - natural:+.2f}")
    toggle = frame("sidebar.toggle")
    if toggle is not None:
        if lights:
            if traffic_bar > 8.0 and abs(toggle[0] - traffic_bar) > ALIGN_TOL:
                problems.append(f"sidebar.toggle X {toggle[0] - traffic_bar:+.2f}")
        else:
            delta = toggle[0] - side_pad
            if abs(delta) > ALIGN_TOL:
                problems.append(f"sidebar.toggle X {delta:+.2f}")
            if traffic_bar > side_pad + 1.0 and abs(toggle[0] - traffic_bar) <= ALIGN_TOL:
                problems.append(f"sidebar.toggle traffic {toggle[0] - traffic_bar:+.2f}")
    if not lights and traffic_bar > side_pad + 1.0:
        for node_id, node in by_id.items():
            if node_id == "sidebar.toggle" or node_id.startswith("traffic."):
                continue
            box = _box(node.get("frame"))
            if box is not None and abs(box[0] - traffic_bar) <= ALIGN_TOL:
                problems.append(f"{node_id} traffic {box[0] - traffic_bar:+.2f}")
    window_box = [0.0, 0.0, window_w, window_h]
    search = frame("sidebar.search")
    title = frame("shelf.header.title")
    cover = frame("cover.0")
    for node_id, box, host in (
        ("sidebar.search", search, sidebar if sidebar is not None else window_box),
        ("shelf.header.title", title, card),
        ("cover.0", cover, card),
    ):
        if box is None or host is None:
            continue
        if (
            box[0] < host[0] - ALIGN_TOL
            or box[1] < host[1] - ALIGN_TOL
            or box[0] + box[2] > host[0] + host[2] + ALIGN_TOL
            or box[1] + box[3] > host[1] + host[3] + ALIGN_TOL
        ):
            problems.append(f"{node_id} outside")
        if (
            box[1] < content_top - ALIGN_TOL
            or box[1] + box[3] > window_h + ALIGN_TOL
        ):
            problems.append(f"{node_id} clipped")
    if toggle is not None and search is not None and _overlaps(toggle, search):
        problems.append("sidebar.search overlaps sidebar.toggle")
    return problems


def _window_key(layout):
    window = layout.get("window") or [0, 0]
    try:
        return (round(float(window[0]), 1), round(float(window[1]), 1))
    except (TypeError, ValueError, IndexError):
        return (0.0, 0.0)


def _frame_map(layout):
    found = {}
    for node in layout.get("nodes") or []:
        if isinstance(node, dict) and isinstance(node.get("id"), str):
            box = _box(node.get("frame"))
            if box is not None:
                found[node["id"]] = box
    return found


def _same_box(left, right):
    return (
        left is not None
        and right is not None
        and all(abs(left[index] - right[index]) <= ALIGN_TOL for index in range(4))
    )


def transition_size_report(pairs):
    """Each enter, settled, and exit frame must use that frame's window.

    A 6pt card gap in a window that is already 855pt passes. A layout that
    stays 1440x855 after the window is 1512x949 does not.
    """
    problems = []
    for label, layout, chrome in pairs:
        for item in available_height_report(layout, chrome):
            problems.append(f"{label} {item}")
    return problems


def transition_report(frames):
    """Settled fullscreen frames do not jump, and leaving fullscreen restores the windowed row."""
    if not isinstance(frames, list) or len(frames) < 2:
        return ["transition needs two frames"]
    ids = ("sidebar.toggle", "sidebar.search", "shelf.header.title", "cover.0")
    problems = []
    for index, layout in enumerate(frames):
        if not isinstance(layout, dict):
            problems.append(f"frame {index} missing")
            continue
        for item in alignment_report(layout):
            if (
                item.startswith("sidebar.toggle")
                or item.startswith("sidebar.search")
                or item.startswith("shelf.header.title")
                or item.startswith("cover.")
                or "overlap" in item
                or item.endswith("outside")
                or item.endswith("clipped")
            ):
                problems.append(f"frame {index} {item}")
    hidden = [layout for layout in frames if isinstance(layout, dict) and layout.get("lights") is False]
    if len(hidden) >= 2:
        size = _window_key(hidden[-1])
        pair = [layout for layout in hidden if _window_key(layout) == size]
        if len(pair) >= 2:
            before = _frame_map(pair[-2])
            after = _frame_map(pair[-1])
            for node_id in ids:
                if node_id in before and node_id in after and not _same_box(before[node_id], after[node_id]):
                    problems.append(f"{node_id} jumps")
    shown = [layout for layout in frames if isinstance(layout, dict) and layout.get("lights") is True]
    if len(shown) >= 2:
        size = _window_key(shown[0])
        pair = [layout for layout in shown if _window_key(layout) == size]
        if len(pair) >= 2:
            before = _frame_map(pair[0])
            after = _frame_map(pair[-1])
            for node_id in ids:
                if node_id in before and node_id in after and not _same_box(before[node_id], after[node_id]):
                    problems.append(f"{node_id} restore")
    return problems


def _sample_layout(shift=0.0):
    def node(node_id, kind, frame, intrinsic=None):
        return {
            "id": node_id,
            "kind": kind,
            "frame": frame,
            "intrinsic": intrinsic if intrinsic is not None else [frame[2], frame[3]],
            "container": [0, 0, 800, 600],
            "ellipsis": False,
            "scroll_child": False,
        }

    return {
        "window": [800, 600],
        "chrome_center": 24.0,
        "inset": 6.0,
        "sidebar_pad_x": 10.0,
        "card_pad_x": 40.0,
        "chat_pad_x": 16.0,
        "window_corner": 18.0,
        "composer_inset": 18.0,
        "composer_pad": 12.0,
        "lights": True,
        "traffic_bar": 92.0,
        "content_top": 0.0,
        "nodes": [
            node("sidebar", "container", [0, 0, 220, 600]),
            node("sidebar.search", "field", [10, 48, 200, 28]),
            node("card", "container", [226, 6, 248, 588]),
            node("toolbar", "container", [226, 6 + shift, 248, 36]),
            node("toolbar.sort", "chrome", [360, 12 + shift, 60, 24]),
            node("toolbar.view", "chrome", [430, 14 + shift, 60, 20]),
            node("sidebar.toggle", "chrome", [92, 10 + shift, 28, 28]),
            node("sidebar.row.0", "sidebar-row", [10, 100, 200, 28]),
            node("sidebar.row.0.icon", "icon", [18, 107, 14, 14]),
            node("sidebar.row.0.label", "text", [44, 106.4, 120, 15.2]),
            node("shelf.header", "container", [266, 54, 162, 36]),
            node("shelf.header.title", "text", [266, 59, 80, 26]),
            node("shelf.header.count", "text", [390, 72, 38, 13]),
            node("shelf.section", "text", [266, 120, 162, 18]),
            node("cover.0", "cover", [266, 200, 70, 105]),
            node("cover.1", "cover", [378, 200, 70, 105]),
            node("chat", "container", [480, 0, 320, 600]),
            node("chat.head", "container", [480, 0, 320, 48]),
            node("chat.avatar", "chrome", [496, 12, 24, 24]),
            node("chat.name", "text", [528, 14, 70, 20]),
            node("chat.sub", "text", [604, 20, 50, 14]),
            node("chat.new", "chrome", [720, 10, 28, 28]),
            node("chat.panel", "chrome", [750, 10, 28, 28]),
            node("sidebar.settings", "sidebar-row", [10, 554, 200, 28]),
            node("sidebar.settings.icon", "icon", [18, 561, 14, 14]),
            node("sidebar.settings.label", "text", [44, 560.4, 120, 15.2]),
            node("composer", "container", [498, 496.4, 284, 85.6]),
            node("composer.placeholder", "text", [510, 508.4, 80, 15.6]),
            node("composer.attach", "chrome", [510, 544, 16, 26]),
            node("composer.chip", "button", [532, 544, 80, 26], intrinsic=[80, 26]),
            node("composer.send", "chrome", [744, 544, 26, 26]),
        ],
    }


def _rgba_rows(rows, width, channels):
    if channels == 4:
        return rows
    out = []
    for row in rows:
        rgba = bytearray(width * 4)
        for x in range(width):
            src = x * channels
            dst = x * 4
            rgba[dst : dst + channels] = row[src : src + channels]
            rgba[dst + 3] = 255
        out.append(rgba)
    return out


def save_zoom_crop(png, layout, dest, box):
    image_w, _image_h, rows = decode_png_rows(png)
    channels = image_channels(rows, image_w)
    window = layout.get("window") or [image_w, 1]
    scale = image_w / float(window[0])
    pixel = [
        int(round(box[0] * scale)),
        int(round(box[1] * scale)),
        max(1, int(round(box[2] * scale))),
        max(1, int(round(box[3] * scale))),
    ]
    cropped, width, height = crop_box(rows, image_w, channels, pixel)
    rgba = _rgba_rows(cropped, width, channels)
    zoomed = scale_rows(rgba, width, 4, width * 4, height * 4)
    flat = bytearray()
    for row in zoomed:
        flat.extend(row)
    Path(dest).write_bytes(encode_png(width * 4, height * 4, flat))


def save_alignment_crops(out, stem, png):
    layout = read_layout_frames()
    if not isinstance(layout, dict) or not Path(png).is_file():
        return
    nodes = {
        node.get("id"): node
        for node in layout.get("nodes") or []
        if isinstance(node, dict)
    }
    window = layout.get("window") or [0, 0]
    try:
        width = float(window[0])
    except (TypeError, ValueError, IndexError):
        return
    toolbar = _box((nodes.get("toolbar") or {}).get("frame"))
    band = 48.0
    if toolbar is not None:
        band = max(band, toolbar[1] + toolbar[3])
    boxes = {"toolbar": [0.0, 0.0, width, band + 8.0]}
    for key in sorted(nodes):
        if key.startswith("sidebar.row.") and key.count(".") == 2:
            row = _box(nodes[key].get("frame"))
            if row is not None:
                boxes["sidebar"] = [
                    max(0.0, row[0] - 8.0),
                    max(0.0, row[1] - 6.0),
                    row[2] + 16.0,
                    row[3] + 12.0,
                ]
                break
    header = _box((nodes.get("shelf.header") or {}).get("frame"))
    if header is not None:
        boxes["header"] = [
            max(0.0, header[0] - 8.0),
            max(0.0, header[1] - 6.0),
            header[2] + 16.0,
            header[3] + 12.0,
        ]
    search = _box((nodes.get("sidebar.search") or {}).get("frame"))
    if search is not None:
        boxes["search"] = [
            max(0.0, search[0] - 8.0),
            max(0.0, search[1] - 16.0),
            search[2] + 16.0,
            search[3] + 28.0,
        ]
    title = _box((nodes.get("shelf.header.title") or {}).get("frame"))
    if title is not None:
        boxes["shelf-title"] = [
            max(0.0, title[0] - 12.0),
            max(0.0, title[1] - 20.0),
            max(title[2] + 24.0, 160.0),
            title[3] + 36.0,
        ]
    try:
        window_h = float(window[1])
    except (TypeError, ValueError, IndexError):
        window_h = None
    settings = _box((nodes.get("sidebar.settings") or {}).get("frame"))
    sidebar = _box((nodes.get("sidebar") or {}).get("frame"))
    toggle = _box((nodes.get("sidebar.toggle") or {}).get("frame"))
    if sidebar is not None and toggle is not None:
        boxes["sidebar-header"] = [
            sidebar[0],
            0.0,
            sidebar[2],
            max(band, toggle[1] + toggle[3] + 12.0),
        ]
    if settings is not None and sidebar is not None and window_h is not None:
        top = max(0.0, settings[1] - 8.0)
        boxes["sidebar-bottom"] = [sidebar[0], top, sidebar[2], max(1.0, window_h - top)]
    composer = _box((nodes.get("composer") or {}).get("frame"))
    chat = _box((nodes.get("chat") or {}).get("frame"))
    if composer is not None and window_h is not None:
        top = max(0.0, composer[1] - 8.0)
        boxes["composer"] = [
            max(0.0, composer[0] - 8.0),
            top,
            composer[2] + 16.0,
            max(1.0, window_h - top),
        ]
        if chat is not None:
            boxes["chat-bottom"] = [chat[0], top, chat[2], max(1.0, window_h - top)]
    for name, box in boxes.items():
        try:
            save_zoom_crop(Path(png), layout, out / f"{stem}-{name}-4x.png", box)
        except (OSError, ValueError, ZeroDivisionError):
            continue


def _box(value):
    if not isinstance(value, list) or len(value) != 4:
        return None
    try:
        return [float(item) for item in value]
    except (TypeError, ValueError):
        return None


def clipping_report(layout):
    """Frames outside a container or the window, and text cut off without an ellipsis."""
    if not isinstance(layout, dict):
        return ["layout.json was not written"]
    window = layout.get("window")
    if not isinstance(window, list) or len(window) < 2:
        return ["window size missing"]
    try:
        window_w = float(window[0])
        window_h = float(window[1])
    except (TypeError, ValueError):
        return ["window size missing"]
    nodes = layout.get("nodes")
    if not isinstance(nodes, list) or not nodes:
        return ["no frames"]
    problems = []
    for node in nodes:
        if not isinstance(node, dict):
            problems.append("node was not an object")
            continue
        name = str(node.get("id") or "node")
        frame = _box(node.get("frame"))
        container = _box(node.get("container"))
        if frame is None or container is None:
            problems.append(f"{name} frame")
            continue
        x, y, width, height = frame
        cx, cy, cw, ch = container
        if x < cx - CLIP_TOL or x + width > cx + cw + CLIP_TOL:
            problems.append(f"{name} extends outside its container")
        if x < -CLIP_TOL or x + width > window_w + CLIP_TOL:
            problems.append(f"{name} extends outside the window")
        if not node.get("scroll_child"):
            if y < cy - CLIP_TOL or y + height > cy + ch + CLIP_TOL:
                problems.append(f"{name} extends outside its container")
            if y < -CLIP_TOL or y + height > window_h + CLIP_TOL:
                problems.append(f"{name} extends outside the window")
        if node.get("kind") == "text":
            intrinsic = node.get("intrinsic")
            try:
                needed = float(intrinsic[0])
            except (TypeError, ValueError, IndexError):
                needed = 0.0
            if needed > width + CLIP_TOL and not node.get("ellipsis"):
                problems.append(f"{name} text is clipped")
    problems.extend(sibling_overlaps(nodes))
    return problems


def _contains(outer, inner, tol=CLIP_TOL):
    ox, oy, ow, oh = outer
    ix, iy, iw, ih = inner
    return (
        ix >= ox - tol
        and iy >= oy - tol
        and ix + iw <= ox + ow + tol
        and iy + ih <= oy + oh + tol
    )


def _overlaps(a, b, tol=CLIP_TOL):
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    return ax < bx + bw - tol and bx < ax + aw - tol and ay < by + bh - tol and by < ay + ah - tol


def sibling_overlaps(nodes):
    """Two frames that cross, and neither sits inside the other, are a clip."""
    frames = []
    for node in nodes:
        if not isinstance(node, dict):
            continue
        frame = _box(node.get("frame"))
        if frame is None:
            continue
        frames.append((str(node.get("id") or "node"), frame))
    problems = []
    for index, (name, frame) in enumerate(frames):
        for other, other_frame in frames[index + 1 :]:
            if not _overlaps(frame, other_frame):
                continue
            if _contains(frame, other_frame) or _contains(other_frame, frame):
                continue
            problems.append(f"{name} overlaps {other}")
    return problems


def frame_outside_x(x, width, origin, span, tol=1.0):
    return x < origin - tol or x + width > origin + span + tol


def ax_window_box(line):
    """`WIN x y w h` when the walk recorded a rectangle. A titled `WIN name` is not a box."""
    parts = line.split()
    if not line.startswith("WIN ") or len(parts) != 5:
        return None
    try:
        return [float(part) for part in parts[1:]]
    except ValueError:
        return None


def _menu_role(role):
    return role.startswith("AXMenu") or role in ("menu", "menu item", "menu bar", "menu bar item")


def ax_walk_has_content(text):
    """A menu bar dumped as a zero-size window is not the shelf.

    System Events still prints `WIN `, so the caller must not treat that line
    as proof the content window was walked.
    """
    if not text or "NO_PROCESS" in text:
        return False
    sized = False
    named = False
    content = False
    for line in text.splitlines():
        if line.startswith("WIN "):
            box = ax_window_box(line)
            if box is not None and box[2] > 1.0 and box[3] > 1.0:
                sized = True
            elif box is None and line.strip() not in ("WIN", "WIN missing value"):
                named = True
            continue
        fields = line.split("\t")
        if len(fields) < 2 or _menu_role(fields[0]):
            continue
        name = fields[1].strip()
        if name and name not in ("missing value", "button"):
            content = True
    return content and (sized or named)


def ax_content_names(text):
    names = []
    for line in text.splitlines():
        fields = line.split("\t")
        if len(fields) < 2:
            continue
        name = fields[1].strip()
        if name and name not in ("missing value", "button"):
            names.append(name)
    return names


def ax_swift_source():
    """Walk titled elements, including static text whose name is AXValue."""
    return r"""
import ApplicationServices
import Foundation

guard CommandLine.arguments.count > 1, let pid = pid_t(CommandLine.arguments[1]) else {
  fputs("pid\n", stderr)
  exit(2)
}

func copyAttr(_ element: AXUIElement, _ name: String) -> CFTypeRef? {
  var value: CFTypeRef?
  if AXUIElementCopyAttributeValue(element, name as CFString, &value) != .success {
    return nil
  }
  return value
}

func pointOrSize(_ value: CFTypeRef?) -> (CGFloat, CGFloat)? {
  guard let value else { return nil }
  let ax = value as! AXValue
  if AXValueGetType(ax) == .cgPoint {
    var point = CGPoint.zero
    if AXValueGetValue(ax, .cgPoint, &point) { return (point.x, point.y) }
  }
  if AXValueGetType(ax) == .cgSize {
    var size = CGSize.zero
    if AXValueGetValue(ax, .cgSize, &size) { return (size.width, size.height) }
  }
  return nil
}

func axName(_ element: AXUIElement) -> String {
  var name = copyAttr(element, kAXTitleAttribute as String) as? String ?? ""
  if name.isEmpty {
    name = copyAttr(element, kAXDescriptionAttribute as String) as? String ?? ""
  }
  if name.isEmpty {
    name = copyAttr(element, kAXValueAttribute as String) as? String ?? ""
  }
  return name.replacingOccurrences(of: "\t", with: " ").replacingOccurrences(of: "\n", with: " ")
}

func walk(_ element: AXUIElement, _ depth: Int) {
  if depth > 14 { return }
  let role = copyAttr(element, kAXRoleAttribute as String) as? String ?? ""
  let name = axName(element)
  let pos = pointOrSize(copyAttr(element, kAXPositionAttribute as String))
  let size = pointOrSize(copyAttr(element, kAXSizeAttribute as String))
  if !name.isEmpty, let pos, let size {
    print("\(role)\t\(name)\t\(pos.0)\t\(pos.1)\t\(size.0)\t\(size.1)")
  }
  if let children = copyAttr(element, kAXChildrenAttribute as String) as? [AXUIElement] {
    for child in children { walk(child, depth + 1) }
  }
}

func walkWindow(_ window: AXUIElement) {
  let pos = pointOrSize(copyAttr(window, kAXPositionAttribute as String)) ?? (0, 0)
  let size = pointOrSize(copyAttr(window, kAXSizeAttribute as String)) ?? (0, 0)
  print("WIN \(pos.0) \(pos.1) \(size.0) \(size.1)")
  walk(window, 0)
}

let app = AXUIElementCreateApplication(pid)
var windows = copyAttr(app, kAXWindowsAttribute as String) as? [AXUIElement] ?? []
if windows.isEmpty, let focused = copyAttr(app, kAXFocusedWindowAttribute as String) {
  windows = [focused as! AXUIElement]
}
if windows.isEmpty, let main = copyAttr(app, kAXMainWindowAttribute as String) {
  windows = [main as! AXUIElement]
}
guard !windows.isEmpty else {
  fputs("accessibility saw no windows\n", stderr)
  exit(3)
}
for window in windows {
  walkWindow(window)
}
"""


def ax_swift_dump(pid):
    """System Events sometimes lists no windows for a process CG can see."""
    binary = Path("/tmp/superreader-spike/ax-walk")
    source = Path("/tmp/superreader-spike/ax-walk.swift")
    try:
        refresh_swift(binary, source, ax_swift_source(), "ax walker")
    except RuntimeError as exc:
        return "", str(exc)
    proc = subprocess.run([str(binary), str(pid)], capture_output=True, text=True)
    if proc.returncode != 0 and not proc.stdout.strip():
        return "", (proc.stderr or proc.stdout or "accessibility saw no windows").strip()
    return proc.stdout, ""


def ax_overflow(pid):
    """Named accessibility elements whose horizontal frame leaves the window.

    A failed walk is retried. A frame that is actually outside is not.
    """
    last = ["accessibility walk found no frames"]
    for attempt in range(3):
        problems = ax_overflow_once(pid)
        failed = len(problems) == 1 and (
            "no frames" in problems[0] or "failed" in problems[0] or problems[0] == "NO_PROCESS"
        )
        if not failed:
            return problems
        last = problems
        if attempt < 2:
            time.sleep(0.4)
    return last


def ax_overflow_once(pid):
    script = f'''
tell application "System Events"
  if not (exists (first process whose unix id is {pid})) then
    return "NO_PROCESS"
  end if
  tell (first process whose unix id is {pid})
    set out to ""
    repeat with w in windows
      try
        set wp to position of w
        set ws to size of w
        set out to out & "WIN " & (item 1 of wp as text) & " " & (item 2 of wp as text) & " " & (item 1 of ws as text) & " " & (item 2 of ws as text) & linefeed
      end try
      set elems to entire contents of w
      repeat with e in elems
        try
          set r to role of e as text
          set n to name of e as text
          if n is "missing value" or n is "" then
            set n to description of e as text
          end if
          if n is "missing value" or n is "" then
            try
              set n to value of e as text
            end try
          end if
          set p to position of e
          set s to size of e
          set out to out & r & tab & n & tab & (item 1 of p as text) & tab & (item 2 of p as text) & tab & (item 1 of s as text) & tab & (item 2 of s as text) & linefeed
        end try
      end repeat
    end repeat
    return out
  end tell
end tell
'''
    proc = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if proc.returncode != 0:
        return [(proc.stderr or proc.stdout or "accessibility walk failed").strip()]
    text = proc.stdout
    if not ax_walk_has_content(text):
        swift_text, swift_err = ax_swift_dump(pid)
        if ax_walk_has_content(swift_text):
            text = swift_text
        elif swift_err and not text.strip():
            return [swift_err]
    window = None
    problems = []
    seen = 0
    for line in text.splitlines():
        if line.startswith("WIN "):
            parts = line.split()
            if len(parts) == 5:
                try:
                    window = [float(part) for part in parts[1:]]
                except ValueError:
                    window = None
            continue
        parts = line.split("\t")
        if len(parts) != 6 or window is None:
            continue
        try:
            x = float(parts[2])
            width = float(parts[4])
        except ValueError:
            continue
        if width <= 0:
            continue
        seen += 1
        if frame_outside_x(x, width, window[0], window[2]):
            label = parts[1].strip() or parts[0]
            problems.append(f"{label} extends outside the window")
    if window is None or seen == 0:
        problems.append("accessibility walk found no frames")
    return problems


def read_layout_frames():
    path = Path("/tmp/superreader-spike/layout.json")
    if not path.is_file():
        return None
    try:
        body = json.loads(path.read_text())
    except json.JSONDecodeError:
        return None
    return body if isinstance(body, dict) else None


