)
MAIN_SHELL = Path("/tmp/spike-shell-main-fdd8183")


def png_pixel_diff(left, right):
    left_w, left_h, left_rows = decode_png_rows(left)
    right_w, right_h, right_rows = decode_png_rows(right)
    if (left_w, left_h) != (right_w, right_h):
        return f"size {left_w}x{left_h} against {right_w}x{right_h}"
    return row_pixel_diff(left_rows, right_rows)


def row_pixel_diff(left_rows, right_rows):
    differ = 0
    for one, other in zip(left_rows, right_rows):
        if one == other:
            continue
        differ += sum(1 for i in range(0, len(one), 4) if one[i : i + 4] != other[i : i + 4])
    return differ


# The page rectangle reaches the window's rounded corner once the bar shifts it
# right. That corner is the window, not the page.
PAGE_CORNER_PT = 8.0


def page_rows(png, body, inset=0.0):
    width, height, rows = decode_png_rows(png)
    try:
        stage = float(body.get("stage_w") or 0)
        x = float(body["page_x"])
        y = float(body["page_y"])
        page_w = float(body["page_w"])
        page_h = float(body["page_h"])
    except (TypeError, ValueError, KeyError):
        return None
    if stage <= 0 or page_w <= 1 or page_h <= 1:
        return None
    if page_w > inset * 2 + 1 and page_h > inset * 2 + 1:
        x += inset
        y += inset
        page_w -= inset * 2
        page_h -= inset * 2
    scale = width / stage
    left = int(round(x * scale))
    top = int(round(y * scale))
    crop_w = int(round(page_w * scale))
    crop_h = int(round(page_h * scale))
    if left < 0 or top < 0 or crop_w < 1 or crop_h < 1:
        return None
    if left + crop_w > width or top + crop_h > height:
        return None
    channels = len(rows[0]) // width
    cropped = [
        row[left * channels : (left + crop_w) * channels] for row in rows[top : top + crop_h]
    ]
    return crop_w, crop_h, cropped


def page_pixel_diff(left_png, left_body, right_png, right_body):
    """Compare the page bitmaps. The traffic-light bar sits outside the page, so a
    whole-window diff against a shell without the bar is not the bold-off check."""
    left = page_rows(left_png, left_body, PAGE_CORNER_PT)
    right = page_rows(right_png, right_body, PAGE_CORNER_PT)
    if left is None or right is None:
        return "page box missing"
    if (left[0], left[1]) != (right[0], right[1]):
        return f"page {left[0]}x{left[1]} against {right[0]}x{right[1]}"
    return row_pixel_diff(left[2], right[2])


# Latin face margin_bottom. The gray system footer lives in this band.
# The fdd8183 baseline still has the serif footer, so bold-off compares
# everything above the band and leaves the band to the new footer.
FOOTER_BAND_PT = 72.0


def footer_band_rows(body, png_width, inset, footer_pt):
    try:
        stage = float(body.get("stage_w") or 0)
        page_w = float(body["page_w"])
        page_h = float(body["page_h"])
    except (TypeError, ValueError, KeyError):
        return None
    if stage <= 0 or png_width <= 0:
        return None
    applied = inset if page_w > inset * 2 + 1 and page_h > inset * 2 + 1 else 0.0
    visible = footer_pt - applied
    if visible <= 0:
        return 0
    return int(round(visible * png_width / stage))


def bold_off_page_diff(left_png, left_body, right_png, right_body, footer_pt=FOOTER_BAND_PT):
    """Exact page match against the baseline above the footer band.

    The system-font footer is the reference inside that band, so those pixels
    are not scored against the serif baseline. A prefix, or any other change
    above the band, still counts. `page_pixel_diff` stays exact.
    """
    left = page_rows(left_png, left_body, PAGE_CORNER_PT)
    right = page_rows(right_png, right_body, PAGE_CORNER_PT)
    if left is None or right is None:
        return "page box missing"
    if (left[0], left[1]) != (right[0], right[1]):
        return f"page {left[0]}x{left[1]} against {right[0]}x{right[1]}"
    left_w, _, _ = decode_png_rows(left_png)
    right_w, _, _ = decode_png_rows(right_png)
    left_band = footer_band_rows(left_body, left_w, PAGE_CORNER_PT, footer_pt)
    right_band = footer_band_rows(right_body, right_w, PAGE_CORNER_PT, footer_pt)
    if left_band is None or right_band is None or left_band != right_band:
        return "footer band missing"
    if left_band >= left[1]:
        return "footer band covers the page"
    if left_band:
        left_rows = left[2][: left[1] - left_band]
        right_rows = right[2][: right[1] - right_band]
    else:
        left_rows = left[2]
        right_rows = right[2]
    return row_pixel_diff(left_rows, right_rows)


def grab_page(state, window_tool, png):
    if not state["alive"]:
        return False
    wait_json(state["started"], layout_settled, 20)
    time.sleep(0.4)
    wid = window_id(window_tool, state["pid"])
    if not wid:
        return False
    capture(wid, png)
    return png.exists() and png.stat().st_size > 1000


def bold_word_starts(out, window_tool):
    rows = []
    write_trim("paperback")
    clear_breaks()
    env = {"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}
    off_png = out / "bold-off.png"
    main_png = out / "bold-main.png"
    off = launch(
        out,
        "bold-off",
        child_env(env),
        lambda names: False,
        45,
        lambda started: chapter_ready(started, "pride"),
    )
    try:
        grabbed = grab_page(off, window_tool, off_png)
        off_body = webkit_body(off["started"]) or {}
        off_box = chrome_pid_body(off["started"], off["pid"]) or read_window_chrome(
            CHROME_JSON, off["started"]
        ) or {}
    finally:
        finish_launch(off)
    clear_breaks()
    main_box = {}
    if MAIN_SHELL.exists():
        baseline = launch(
            out,
            "bold-main",
            child_env(env),
            lambda names: False,
            45,
            lambda started: chapter_ready(started, "pride"),
            MAIN_SHELL,
        )
        try:
            grabbed = grab_page(baseline, window_tool, main_png) and grabbed
            main_box = read_window_chrome(CHROME_JSON, baseline["started"]) or {}
        finally:
            finish_launch(baseline)
    else:
        grabbed = False
    prefixes = off_body.get("bold_prefixes")
    dom_off = prefixes == []
    if not MAIN_SHELL.exists():
        rows.append(
            check(
                "bold-word-starts-off",
                "bold-word-starts",
                "window",
                "pending",
                f"not executed: baseline binary missing at {MAIN_SHELL}; prefixes {prefixes}. This is not a typesetting pass or fail.",
                "bold-off.png",
            )
        )
    else:
        if not grabbed:
            pixel = "a window capture is missing"
        else:
            pixel = bold_off_page_diff(off_png, off_box, main_png, main_box)
        off_ok = dom_off and pixel == 0
        rows.append(
            check(
                "bold-word-starts-off",
                "bold-word-starts",
                "window",
                "pass" if off_ok else "fail",
                f"prefixes {prefixes} pixels {pixel} above the {FOOTER_BAND_PT:.0f}pt footer",
                "bold-off.png",
            )
        )
    SETTINGS.write_text('{"trim":"paperback","boldWordStarts":true}\n')
    clear_breaks()
    on = launch(
        out,
        "bold-on",
        child_env({**env, "SPIKE_BOLD_PROBES": "1"}),
        lambda names: False,
        45,
        lambda started: chapter_ready(started, "pride"),
    )
    try:
        on_body = webkit_body(on["started"]) or {}
    finally:
        finish_launch(on)
    got = on_body.get("bold_prefixes")
    rows.append(
        check(
            "bold-word-starts-on",
            "bold-word-starts",
            "window",
            "pass" if got == list(BOLD_PROBES) else "fail",
            f"prefixes {got}",
        )
    )
    write_trim("paperback")
    clear_breaks()
    return rows


def write_bold(on):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps({"trim": "paperback", "boldWordStarts": on}) + "\n")


def settled_pride(started):
    body = webkit_body(started)
    return (
        body is not None
        and isinstance(body.get("page_ready_ms"), (int, float))
        and layout_settled(body)
        and chapter_ready(started, "pride")
    )


def mode_facts(body):
    layout = layout_of(body) or {}
    pages = body.get("pages")
    count = pages[1] if isinstance(pages, list) and len(pages) == 2 else None
    overflow = layout.get("overflow_lines")
    live = layout.get("live_calls")
    return {
        "source": layout.get("break_source"),
        "live": live,
        "overflow": overflow,
        "pages": count,
    }


def bold_break_cache(out):
    reap_our_shells()
    clear_breaks()
    write_bold(False)
    timed_open(out, "bold-cache-off-prime", True, {}, settled_pride, 60)
    off_cached = mode_facts(timed_open(out, "bold-cache-off-cached", True, {}, settled_pride, 60))
    write_bold(True)
    on_live = mode_facts(timed_open(out, "bold-cache-on-live", True, {}, settled_pride, 60))
    on_cached = mode_facts(timed_open(out, "bold-cache-on-cached", True, {}, settled_pride, 60))
    write_bold(False)
    off_live = mode_facts(timed_open(out, "bold-cache-off-live", True, {}, settled_pride, 60))
    off_again = mode_facts(timed_open(out, "bold-cache-off-again", True, {}, settled_pride, 60))
    write_trim("paperback")
    clear_breaks()

    def fresh(facts):
        live = facts["live"]
        return facts["source"] == "live" and isinstance(live, (int, float)) and live > 0 and facts["overflow"] in (0, 0.0)

    def reused(facts, live_facts):
        return (
            facts["source"] == "cached"
            and facts["live"] == 0
            and facts["overflow"] in (0, 0.0)
            and facts["overflow"] == live_facts["overflow"]
            and facts["pages"] == live_facts["pages"]
            and isinstance(facts["pages"], int)
            and facts["pages"] > 1
        )

    ok = (
        off_cached["source"] == "cached"
        and off_cached["live"] == 0
        and fresh(on_live)
        and reused(on_cached, on_live)
        and fresh(off_live)
        and reused(off_again, off_live)
        and off_live["pages"] == off_cached["pages"] == off_again["pages"]
    )
    return check(
        "bold-word-starts-cache",
        "bold-word-starts",
        "window",
        "pass" if ok else "fail",
        f"off cached {off_cached} on live {on_live} on cached {on_cached} "
        f"off live {off_live} off again {off_again}",
    )


def compile_swift(out, name, source):
    path = out / f"{name}.swift"
    path.write_text(source)
    binary = out / name
    proc = subprocess.run(["swiftc", "-o", str(binary), str(path)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or f"{name} swiftc failed")
    return binary


def run_bar(out, window_tool):
    rows = []

    def row(name, ok, detail):
        rows.append(check(name, "sidebar", "window", "pass" if ok else "fail", detail))

    lights = compile_swift(
        out,
        "shell-lights",
        """
import AppKit
import ApplicationServices
import CoreGraphics
guard CommandLine.arguments.count > 1, let pid = pid_t(CommandLine.arguments[1]) else { exit(2) }
let app = AXUIElementCreateApplication(pid)
var raw: CFTypeRef?
guard AXUIElementCopyAttributeValue(app, kAXWindowsAttribute as CFString, &raw) == .success,
      let windows = raw as? [AXUIElement], !windows.isEmpty else {
  fputs("no window\\n", stderr)
  exit(1)
}
func axValue(_ el: AXUIElement, _ name: String) -> CFTypeRef? {
  var value: CFTypeRef?
  guard AXUIElementCopyAttributeValue(el, name as CFString, &value) == .success else { return nil }
  return value
}
func box(_ el: AXUIElement) -> (CGFloat, CGFloat, CGFloat, CGFloat)? {
  guard let p = axValue(el, kAXPositionAttribute as String),
        let s = axValue(el, kAXSizeAttribute as String),
        CFGetTypeID(p) == AXValueGetTypeID(),
        CFGetTypeID(s) == AXValueGetTypeID() else { return nil }
  var pos = CGPoint.zero
  var size = CGSize.zero
  guard AXValueGetValue(p as! AXValue, .cgPoint, &pos),
        AXValueGetValue(s as! AXValue, .cgSize, &size) else { return nil }
  return (pos.x, pos.y, size.width, size.height)
}
var found: [String: (CGFloat, CGFloat, CGFloat, CGFloat)] = [:]
func walk(_ el: AXUIElement, _ depth: Int) {
  if depth > 14 { return }
  let role = axValue(el, kAXSubroleAttribute as String) as? String ?? ""
  if role == "AXCloseButton" || role == "AXMinimizeButton" || role == "AXZoomButton" || role == "AXFullScreenButton" {
    if let frame = box(el) { found[role] = frame }
  }
  var kids: CFTypeRef?
  if AXUIElementCopyAttributeValue(el, kAXChildrenAttribute as CFString, &kids) == .success,
     let kids = kids as? [AXUIElement] {
    for kid in kids { walk(kid, depth + 1) }
  }
}
var origin: (CGFloat, CGFloat, CGFloat, CGFloat)?
var bestArea: CGFloat = -1
for window in windows {
  walk(window, 0)
  if let frame = box(window) {
    let area = frame.2 * frame.3
    if area > bestArea {
      bestArea = area
      origin = frame
    }
  }
}
var menuRaw: CFTypeRef?
if AXUIElementCopyAttributeValue(app, kAXMenuBarAttribute as CFString, &menuRaw) == .success, let menuRaw {
  walk(unsafeBitCast(menuRaw, to: AXUIElement.self), 0)
}
guard let origin,
      let close = found["AXCloseButton"],
      let mini = found["AXMinimizeButton"],
      let zoom = found["AXZoomButton"] ?? found["AXFullScreenButton"] else {
  fputs("missing \\(Array(found.keys))\\n", stderr)
  exit(1)
}
func local(_ item: (CGFloat, CGFloat, CGFloat, CGFloat)) -> String {
  let minX = item.0 - origin.0
  return "\\(minX) \\(minX + item.2) \\(item.1 - origin.1) \\(item.1 - origin.1 + item.3)"
}
print("close \\(local(close)) mini \\(local(mini)) zoom \\(local(zoom))")
""",
    )
    crop = compile_swift(
        out,
        "shell-bar-crop",
        """
import AppKit
import CoreText
import ImageIO
import UniformTypeIdentifiers
let args = CommandLine.arguments
guard args.count > 8,
      let windowW = Double(args[3]),
      let barW = Double(args[4]),
      let closeMin = Double(args[5]),
      let zoomMax = Double(args[6]),
      let leftGap = Double(args[7]),
      let rightGap = Double(args[8]) else { exit(2) }
let src = URL(fileURLWithPath: args[1])
let dst = URL(fileURLWithPath: args[2])
guard let data = try? Data(contentsOf: src),
      let source = CGImageSourceCreateWithData(data as CFData, nil),
      let image = CGImageSourceCreateImageAtIndex(source, 0, nil) else { exit(1) }
let pixelW = CGFloat(image.width)
let pixelH = CGFloat(image.height)
let backing = pixelW / CGFloat(windowW)
let cropW = min(CGFloat(barW) * backing, pixelW)
let cropH = min(72 * backing, pixelH)
guard let cropped = image.cropping(to: CGRect(x: 0, y: 0, width: cropW, height: cropH)) else { exit(1) }
let outW = Int(cropW * 2)
let outH = Int(cropH * 2)
guard let ctx = CGContext(data: nil, width: outW, height: outH, bitsPerComponent: 8, bytesPerRow: 0, space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { exit(1) }
ctx.interpolationQuality = .none
ctx.draw(cropped, in: CGRect(x: 0, y: 0, width: outW, height: outH))
let scale = backing * 2
func vx(_ pt: Double) -> CGFloat { CGFloat(pt) * scale }
ctx.setStrokeColor(CGColor(red: 0.75, green: 0.15, blue: 0.12, alpha: 1))
ctx.setLineWidth(2)
for x in [closeMin, zoomMax, barW] {
  ctx.move(to: CGPoint(x: vx(x), y: 0))
  ctx.addLine(to: CGPoint(x: vx(x), y: CGFloat(outH)))
}
ctx.strokePath()
func label(_ text: String, _ x: CGFloat, alignRight: Bool = false) {
  let font = CTFontCreateWithName("Iowan Old Style" as CFString, 22, nil)
  let attrs: [NSAttributedString.Key: Any] = [.font: font, .foregroundColor: NSColor(red: 0.75, green: 0.15, blue: 0.12, alpha: 1)]
  let line = CTLineCreateWithAttributedString(NSAttributedString(string: text, attributes: attrs))
  let textW = CGFloat(CTLineGetTypographicBounds(line, nil, nil, nil))
  var origin = x
  if alignRight {
    origin = min(x, CGFloat(outW) - textW - 8)
  }
  ctx.textPosition = CGPoint(x: max(origin, 4), y: 18)
  CTLineDraw(line, ctx)
}
label(String(format: "L %.1f", leftGap), vx(0) + 6)
label(String(format: "R %.1f", rightGap), vx(barW) - 8, alignRight: true)
guard let painted = ctx.makeImage(),
      let dest = CGImageDestinationCreateWithURL(dst as CFURL, UTType.png.identifier as CFString, 1, nil) else { exit(1) }
CGImageDestinationAddImage(dest, painted, nil)
if !CGImageDestinationFinalize(dest) { exit(1) }
""",
    )

    def read_lights(pid):
        proc = subprocess.run([str(lights), str(pid)], capture_output=True, text=True)
        if proc.returncode != 0:
            return None, (proc.stderr or proc.stdout or "lights failed").strip()
        parts = proc.stdout.split()
        if len(parts) != 15 or parts[0] != "close" or parts[5] != "mini" or parts[10] != "zoom":
            return None, proc.stdout.strip() or "bad lights line"
        try:
            keys = (
                "close_min_x", "close_max_x", "close_min_y", "close_max_y",
                "mini_min_x", "mini_max_x", "mini_min_y", "mini_max_y",
                "zoom_min_x", "zoom_max_x", "zoom_min_y", "zoom_max_y",
            )
            values = [float(parts[i]) for i in (1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14)]
            return dict(zip(keys, values)), ""
        except ValueError:
            return None, proc.stdout.strip()

    def wait_body(started, pred, timeout=12, reader=None):
        read = reader or (lambda: chrome_body(started))
        deadline = time.time() + timeout
        last = {}
        while time.time() < deadline:
            body = read()
            if isinstance(body, dict):
                last = body
                if pred(body):
                    return body
            time.sleep(0.12)
        return last

    owned = {"pid": None, "started": None}

    def own_body():
        if owned["pid"] is None:
            return None
        return chrome_pid_body(owned["started"], owned["pid"])

    def settled(item):
        return (
            isinstance(item, dict)
            and item.get("bar_dirty") is False
            and float(item.get("bar_w") or 0) > 8
            and float(item.get("close_min_x") or 0) > 0
        )

    def point_at_lights(metrics, fullscreen):
        if not metrics or "x" not in metrics:
            return
        x = metrics["x"] + min(72.0, max(metrics["w"] * 0.5, 24.0))
        y = 1.0 if fullscreen else metrics["y"] + 6.0
        subprocess.run([str(mouse), f"{x:.1f}", f"{max(y, 0.0):.1f}"], capture_output=True)

    def show_and_read(pid, started, fullscreen=False):
        metrics = window_metrics(window_tool, pid)
        point_at_lights(metrics, fullscreen)
        if metrics and "x" in metrics:
            wait_body(
                started,
                lambda item: float(item.get("lights") or 0) >= 0.9,
                timeout=4,
                reader=own_body,
            )
        frames, err = None, "no lights"
        tries = 16 if fullscreen else 8
        for _ in range(tries):
            frames, err = read_lights(pid)
            if frames is not None:
                break
            point_at_lights(metrics, fullscreen)
            time.sleep(0.3)
        return frames, err, metrics

    def centered(body, frames):
        left, right = light_gaps(
            frames["close_min_x"],
            frames["zoom_max_x"],
            float(body.get("bar_x") or 0),
            float(body.get("bar_w") or 0),
        )
        return abs(left - right) <= 0.5 and left > 0 and right > 0, left, right

    mouse = compile_mouse(out)
    state = None
    try:
        clear_bar_hooks()
        SHELL_FRAME.parent.mkdir(parents=True, exist_ok=True)
        SHELL_FRAME.write_text("1100 830\n")
        state = launch(
            out,
            "shell-bar",
            child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"}),
            lambda names: False,
            40,
            lambda started: chrome_ready(started, "pride"),
        )
        if not state["alive"]:
            for name in (
                "sidebar-centered",
                "sidebar-page",
                "sidebar-icon",
                "sidebar-fixed",
                "sidebar-immersive",
                "sidebar-fullscreen",
            ):
                row(name, False, "bar shell exited")
            return rows
        pid = state["pid"]
        started = state["started"]
        owned["pid"] = pid
        owned["started"] = started
        body = wait_body(started, settled, timeout=15, reader=own_body)
        frames, err, metrics = show_and_read(pid, started)
        fresh = wait_body(started, settled, timeout=4, reader=own_body)
        if settled(fresh):
            body = fresh
        if frames is None or not settled(body):
            detail = err if frames is None else f"dirty {body.get('bar_dirty')} bar {body.get('bar_w')}"
            for name in (
                "sidebar-centered",
                "sidebar-page",
                "sidebar-icon",
                "sidebar-fixed",
                "sidebar-immersive",
                "sidebar-fullscreen",
            ):
                row(name, False, detail)
            return rows
        ok, left, right = centered(body, frames)
        detail = (
            f"close ({frames['close_min_x']:.1f},{frames['close_min_y']:.1f})-({frames['close_max_x']:.1f},{frames['close_max_y']:.1f}) "
            f"mini ({frames['mini_min_x']:.1f},{frames['mini_min_y']:.1f})-({frames['mini_max_x']:.1f},{frames['mini_max_y']:.1f}) "
            f"zoom ({frames['zoom_min_x']:.1f},{frames['zoom_min_y']:.1f})-({frames['zoom_max_x']:.1f},{frames['zoom_max_y']:.1f}) "
            f"bar {float(body.get('bar_w') or 0):.1f} left {left:.1f} right {right:.1f}"
        )
        shown = wait_body(
            started,
            lambda item: icon_placement(item)[0],
            timeout=6,
            reader=own_body,
        )
        if shown:
            body = shown
        page_ok = content_centered(body)
        icon_ok, icon_detail = icon_placement(body)
        row("sidebar-centered", ok, detail)
        row(
            "sidebar-page",
            page_ok,
            f"page {float(body.get('page_x') or 0):.1f}+{float(body.get('page_w') or 0):.1f} "
            f"stage {float(body.get('stage_w') or 0):.1f} bar {float(body.get('bar_w') or 0):.1f}",
        )
        row("sidebar-icon", icon_ok, icon_detail)
        if metrics and "id" in metrics:
            shot = out / "bar-window.png"
            capture(metrics["id"], shot)
            proof = ROOT / "docs" / "design" / "shell"
            proof.mkdir(parents=True, exist_ok=True)
            shutil.copy(shot, proof / "bar-window.png")
            annotated = out / "bar-lights.png"
            proc = subprocess.run(
                [
                    str(crop), str(shot), str(annotated), str(metrics["w"]),
                    str(body.get("bar_w")), str(frames["close_min_x"]), str(frames["zoom_max_x"]),
                    f"{left:.1f}", f"{right:.1f}",
                ],
                capture_output=True,
                text=True,
            )
            if proc.returncode == 0 and annotated.exists():
                shutil.copy(annotated, proof / "bar-lights.png")
        first_w = float(body.get("bar_w") or 0)
        first_gen = int(body.get("bar_gen") or 0)
        SHELL_FRAME.write_text("1280 830\n")
        resized = wait_body(
            started,
            lambda item: (
                abs(float(item.get("stage_w") or 0) - 1280) < 40
                and settled(item)
                and content_centered(item)
            ),
            timeout=12,
            reader=own_body,
        )
        again, again_err, _metrics = show_and_read(pid, started)
        if again is None:
            row("sidebar-fixed", False, again_err)
        else:
            grown = float(resized.get("bar_w") or 0)
            gaps_ok, left2, right2 = centered(resized, again)
            fixed = (
                abs(grown - first_w) <= 0.5
                and gaps_ok
                and int(resized.get("bar_gen") or 0) == first_gen
                and content_centered(resized)
            )
            row(
                "sidebar-fixed",
                fixed,
                f"width {first_w:.1f} then {grown:.1f} gen {resized.get('bar_gen')} "
                f"stage {resized.get('stage_w')} page {resized.get('page_x')} "
                f"left {left2:.1f} right {right2:.1f}",
            )
        BAR_IMMERSIVE.write_text("1\n")
        entered = wait_body(
            started,
            lambda item: item.get("immersive") is True and settled(item) and int(item.get("bar_gen") or 0) > first_gen,
            timeout=8,
            reader=own_body,
        )
        BAR_IMMERSIVE.write_text("0\n")
        back = wait_body(
            started,
            lambda item: item.get("immersive") is False and settled(item) and int(item.get("bar_gen") or 0) > int(entered.get("bar_gen") or 0),
            timeout=8,
            reader=own_body,
        )
        restored, restored_err, _metrics = show_and_read(pid, started)
        if restored is None or not back:
            row("sidebar-immersive", False, restored_err if restored is None else "immersive did not settle")
        else:
            gaps_ok, left3, right3 = centered(back, restored)
            held = (
                abs(float(back.get("bar_w") or 0) - first_w) <= 0.5
                and gaps_ok
                and content_centered(back)
            )
            row(
                "sidebar-immersive",
                held,
                f"after immersive bar {float(back.get('bar_w') or 0):.1f} "
                f"page {back.get('page_x')} stage {back.get('stage_w')} "
                f"left {left3:.1f} right {right3:.1f} gen {back.get('bar_gen')}",
            )
        BAR_FULLSCREEN.write_text("1\n")
        wait_body(started, lambda item: item.get("fullscreen") is True, timeout=12, reader=own_body)
        point_at_lights(window_metrics(window_tool, pid), True)
        time.sleep(0.7)
        full = wait_body(
            started,
            lambda item: item.get("fullscreen") is True and settled(item),
            timeout=12,
            reader=own_body,
        )
        full_frames, full_err, full_metrics = show_and_read(pid, started, fullscreen=True)
        painted = None
        full_shot = out / "bar-fullscreen.png"
        if full_metrics and full_metrics.get("id"):
            try:
                capture(full_metrics["id"], full_shot)
                if full_frames is None:
                    image_w, _image_h, image_rows = decode_png_rows(full_shot)
                    painted = bar_column_pt(
                        image_w,
                        image_rows,
                        float(full.get("window_w") or full_metrics.get("w") or 0),
                    )
            except (RuntimeError, ValueError, OSError) as exc:
                full_err = f"{full_err} paint {exc}".strip()

        def save_full_crop(body, left_gap, right_gap):
            if not full_shot.exists() or not full_metrics or "w" not in full_metrics:
                return
            annotated = out / "bar-fullscreen-lights.png"
            proc = subprocess.run(
                [
                    str(crop), str(full_shot), str(annotated), str(full_metrics["w"]),
                    str(body.get("bar_w")), str(body.get("close_min_x")), str(body.get("zoom_max_x")),
                    f"{left_gap:.1f}", f"{right_gap:.1f}",
                ],
                capture_output=True,
                text=True,
            )
            if proc.returncode == 0 and annotated.exists():
                proof = ROOT / "docs" / "design" / "shell"
                proof.mkdir(parents=True, exist_ok=True)
                shutil.copy(annotated, proof / "bar-fullscreen.png")
        fresh = wait_body(
            started,
            lambda item: item.get("fullscreen") is True and settled(item),
            timeout=4,
            reader=own_body,
        )
        if settled(fresh) and fresh.get("fullscreen") is True:
            full = fresh
        BAR_FULLSCREEN.write_text("0\n")
        wait_body(started, lambda item: item.get("fullscreen") is False, timeout=12, reader=own_body)
        point_at_lights(window_metrics(window_tool, pid), False)
        time.sleep(0.5)
        left_full = wait_body(
            started,
            lambda item: item.get("fullscreen") is False and settled(item),
            timeout=12,
            reader=own_body,
        )
        home, home_err, _metrics = show_and_read(pid, started)
        fresh = wait_body(
            started,
            lambda item: item.get("fullscreen") is False and settled(item),
            timeout=4,
            reader=own_body,
        )
        if settled(fresh):
            left_full = fresh
        returned = abs(float(left_full.get("bar_w") or 0) - first_w) <= 0.5 and left_full.get("fullscreen") is False
        if home is None or full.get("fullscreen") is not True:
            row(
                "sidebar-fullscreen",
                False,
                f"{full_err or home_err} fullscreen={full.get('fullscreen')} dirty={full.get('bar_dirty')} bar={full.get('bar_w')} home={home_err}",
            )
        elif full_frames is not None:
            full_ok, full_left, full_right = centered(full, full_frames)
            home_ok, home_left, home_right = centered(left_full, home)
            save_full_crop(full, full_left, full_right)
            row(
                "sidebar-fullscreen",
                full_ok and home_ok and returned,
                f"full bar {float(full.get('bar_w') or 0):.1f} left {full_left:.1f} right {full_right:.1f} then {float(left_full.get('bar_w') or 0):.1f} left {home_left:.1f} right {home_right:.1f}",
            )
        else:
            bar_w = float(full.get("bar_w") or 0)
            gap_left = float(full.get("close_min_x") or 0)
            gap_right = bar_w - float(full.get("zoom_max_x") or 0)
            gaps_ok = abs(gap_left - gap_right) <= 0.5 and gap_left > 0 and gap_right > 0
            home_ok, home_left, home_right = centered(left_full, home)
            save_full_crop(full, gap_left, gap_right)
            row(
                "sidebar-fullscreen",
                gaps_ok and not gray_strip_painted(painted) and home_ok and returned,
                f"full bar {bar_w:.1f} painted {painted if painted is not None else 'none'} gaps {gap_left:.1f}/{gap_right:.1f} then {float(left_full.get('bar_w') or 0):.1f} left {home_left:.1f} right {home_right:.1f}",
            )
    finally:
        if state:
            finish_launch(state)
        clear_bar_hooks()
    return rows


READER_JSON = Path("/tmp/superreader-spike/reader.json")


def reader_body(started):
    if not READER_JSON.exists() or READER_JSON.stat().st_mtime + 0.05 < started:
        return None
    try:
        return json.loads(READER_JSON.read_text())
    except json.JSONDecodeError:
        return None


def click_named(pid, name):
    safe = name.replace("\\", "\\\\").replace('"', '\\"')
    script = f'''
tell application "System Events"
  tell (first process whose unix id is {pid})
    set frontmost to true
    repeat with w in windows
      set elems to entire contents of w
      repeat with e in elems
        try
          set n to name of e as text
          if n is "missing value" or n is "" then
            set n to description of e as text
          end if
          if n is "{safe}" then
            click e
            return "clicked"
          end if
        end try
      end repeat
    end repeat
  end tell
end tell
return "missing"
'''
    proc = subprocess.run(
        ["osascript", "-e", script],
        capture_output=True,
        text=True,
        timeout=30,
    )
    return proc.returncode == 0 and "clicked" in (proc.stdout or "")


def png_dark_pixels(path):
    width, height, rows = decode_png_rows(path)
    if width < 1 or height < 1:
        return 0
    channels = len(rows[0]) // width
    dark = 0
    y0, y1 = int(height * 0.15), int(height * 0.9)
    x0, x1 = int(width * 0.1), int(width * 0.9)
    for y in range(max(y0, 0), min(y1, height)):
        row = rows[y]
        for x in range(max(x0, 0), min(x1, width)):
            i = x * channels
            if row[i] < 210 or row[i + 1] < 210 or row[i + 2] < 210:
                dark += 1
    return dark


def wait_reader(started, want_mode, needle, timeout):
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        body = reader_body(started)
        last = body
        if isinstance(body, dict) and body.get("mode") == want_mode and needle in str(body.get("path") or ""):
            return body
        time.sleep(0.3)
    return last


def run_shelf_windows(out, window_tool):
    apple = ROOT / "spikes" / "library" / "fixtures" / "apple"
    env = child_env(
        {
            "SPIKE_LANG": "en",
            "SUPERREADER_LIBRARY": str(apple),
        }
    )
    state = launch(
        out,
        "shelf-window",
        env,
        lambda names: "Import from Apple Books" in names,
        20,
    )
    rows = []
    try:
        (out / "shelf-window-ax.txt").write_text(state["dump"])
        window = window_id(window_tool, state["pid"]) if state["alive"] else None
        if window is None:
            detail = "shelf window did not appear"
            return [
                check("shelf-window-epub", "library-shelf", "window", "fail", detail),
                check("shelf-window-pdf", "library-shelf", "window", "fail", detail),
                check("shelf-window-switch", "library-shelf", "window", "fail", detail),
            ]

        def shot(name, min_ink=0):
            path = out / f"{name}.png"
            capture(window, path)
            # The EPUB web view reports the open before it has painted.
            deadline = time.time() + 8
            while min_ink > 0 and png_dark_pixels(path) <= min_ink and time.time() < deadline:
                time.sleep(0.3)
                capture(window, path)
            return path

        empty = shot("shelf-empty")
        if not click_named(state["pid"], "Import from Apple Books"):
            raise RuntimeError("could not press Import from Apple Books")
        time.sleep(0.6)
        names, dump = ax_names(state["pid"])
        (out / "shelf-imported-ax.txt").write_text(dump)
        if "Plain Essay" not in names or "Field Guide" not in names:
            raise RuntimeError("imported shelf is missing Plain Essay or Field Guide")
        if not click_named(state["pid"], "Plain Essay"):
            raise RuntimeError("could not press Plain Essay")
        epub = wait_reader(state["started"], "epub", "Plain Essay", 12)
        epub_png = shot("shelf-epub", 200)
        epub_ink = png_dark_pixels(epub_png)
        epub_ok = (
            isinstance(epub, dict)
            and epub.get("mode") == "epub"
            and "Plain Essay" in str(epub.get("path") or "")
            and epub_ink > 200
        )
        rows.append(
            check(
                "shelf-window-epub",
                "library-shelf",
                "window",
                "pass" if epub_ok else "fail",
                f"mode {None if not isinstance(epub, dict) else epub.get('mode')} ink {epub_ink} {epub_png.name}",
                epub_png.name,
            )
        )
        if not click_named(state["pid"], "Library"):
            raise RuntimeError("could not press Library after the epub")
        time.sleep(0.4)
        if not click_named(state["pid"], "Field Guide"):
            raise RuntimeError("could not press Field Guide")
        pdf = wait_reader(state["started"], "pdf", "Field Guide", 12)
        pdf_png = shot("shelf-pdf")
        pdf_ink = png_dark_pixels(pdf_png)
        pdf_ok = (
            isinstance(pdf, dict)
            and pdf.get("mode") == "pdf"
            and "Field Guide" in str(pdf.get("path") or "")
            and pdf_ink > 200
        )
        rows.append(
            check(
                "shelf-window-pdf",
                "library-shelf",
                "window",
                "pass" if pdf_ok else "fail",
                f"mode {None if not isinstance(pdf, dict) else pdf.get('mode')} ink {pdf_ink} {pdf_png.name}",
                pdf_png.name,
            )
        )
        if not click_named(state["pid"], "Library"):
            raise RuntimeError("could not press Library after the pdf")
        time.sleep(0.4)
        if not click_named(state["pid"], "Plain Essay"):
            raise RuntimeError("could not press Plain Essay after the pdf")
        back = wait_reader(state["started"], "epub", "Plain Essay", 12)
        back_png = shot("shelf-switch-epub", 200)
        back_ink = png_dark_pixels(back_png)
        back_ok = (
            isinstance(back, dict)
            and back.get("mode") == "epub"
            and "Plain Essay" in str(back.get("path") or "")
            and back_ink > 200
        )
        rows.append(
            check(
                "shelf-window-switch",
                "library-shelf",
                "window",
                "pass" if back_ok else "fail",
                f"mode {None if not isinstance(back, dict) else back.get('mode')} ink {back_ink} {back_png.name}",
                back_png.name,
            )
        )
        empty_ok = empty.exists()
        rows.append(
            check(
                "shelf-window-empty",
                "library-shelf",
                "window",
                "pass" if empty_ok else "fail",
                empty.name,
                empty.name,
            )
        )
        return rows
    finally:
        finish_launch(state)


def press_right(pid):
    subprocess.run(
        [
            "osascript",
            "-e",
            f'tell application "System Events" to set frontmost of (first process whose unix id is {pid}) to true',
        ],
        capture_output=True,
        text=True,
    )
    subprocess.run(
        ["osascript", "-e", 'tell application "System Events" to key code 124'],
        capture_output=True,
        text=True,
    )


def run_smoke(out, window_tool):
    """Launch the default book and turn one page. This is the short smoke, not the full suite."""
    state = launch(
        out,
        "smoke",
        child_env({}),
        lambda names: False,
        25,
        watch=lambda started: (
            isinstance((body := reader_body(started)), dict)
            and body.get("mode") == "pdf"
            and int(body.get("page") or 0) >= 1
        ),
    )
    try:
        if not state["alive"]:
            detail = "smoke launch exited before a book was open"
            return [
                check("smoke-launch", "smoke", "window", "fail", detail),
                check("smoke-open", "smoke", "window", "fail", detail),
                check("smoke-turn", "smoke", "window", "fail", detail),
            ]
        window = window_id(window_tool, state["pid"])
        opened = reader_body(state["started"]) or {}
        open_png = out / "shelf-smoke-open.png"
        if window:
            capture(window, open_png)
        page = int(opened.get("page") or 0) if isinstance(opened, dict) else 0
        mode = opened.get("mode") if isinstance(opened, dict) else None
        library_form = mode not in ("pdf", "epub")
        reading_note = SHELL_CLICK_GAP
        open_ok = isinstance(opened, dict) and mode == "pdf" and page >= 1
        rows = [
            check("smoke-launch", "smoke", "window", "pass", f"pid {state['pid']}"),
            check(
                "smoke-open",
                "smoke",
                "window",
                "pending" if library_form else ("pass" if open_ok else "fail"),
                reading_note if library_form else f"mode {mode} page {page} {open_png.name}",
                open_png.name,
            ),
        ]
        press_right(state["pid"])
        turned = None
        deadline = time.time() + 15
        next_press = time.time() + 1.5
        while time.time() < deadline:
            body = reader_body(state["started"])
            if isinstance(body, dict) and int(body.get("page") or 0) >= page + 1:
                turned = body
                break
            if time.time() >= next_press:
                press_right(state["pid"])
                next_press = time.time() + 1.5
            time.sleep(0.3)
        turn_png = out / "shelf-smoke-turn.png"
        if window:
            capture(window, turn_png)
        turn_page = None if not isinstance(turned, dict) else turned.get("page")
        turned_ok = isinstance(turn_page, int) and turn_page >= page + 1 and page >= 1
        rows.append(
            check(
                "smoke-turn",
                "smoke",
                "window",
                "pending" if library_form else ("pass" if turned_ok else "fail"),
                reading_note if library_form else f"page {page} then {turn_page} {turn_png.name}",
                turn_png.name,
            )
        )
        if library_form:
            rows.append(check("smoke-shell-click", "smoke", "window", "pending", SHELL_CLICK_GAP))
        return rows
    finally:
        finish_launch(state)


def main():
    parser = argparse.ArgumentParser(description="Score the SuperReader spike.")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--doctor", action="store_true")
    parser.add_argument(
        "--subset",
        choices=["cache", "alpha", "shelf", "preflight"],
        help="preflight launches only the shell form: 1440, minimum, fullscreen enter/settle/exit, accessibility titles, and the shelf wheel",
    )
    args = parser.parse_args()
    if args.doctor:
        rows = doctor()
        for row in rows:
            print(f"{row['status']} {row['id']} {row['detail']}")
        return 1 if doctor_failed(rows) else 0
    if args.self_test:
        self_test()
        print("self-test passed")
        return 0
    try:
        self_test()
    except Exception as exc:
        print(f"self-test failed: {exc}", file=sys.stderr)
        return 1
    if os.environ.get("SR_VERIFY_LOCK_HELD") == "1":
        load_start = float(os.environ["SR_VERIFY_LOAD_START"])
    else:
        load_start = hold_verify_lock()
    if load_start >= load_ceiling():
        print(
            f"not started: 1m loadavg={load_start:.2f} is not under the prescribed ceiling {load_ceiling():g}. "
            "SR_VERIFY_MAX_LOAD cannot raise it. No process was killed.",
            flush=True,
        )
        return 75
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    out = args.out or (ROOT / "docs" / "verify" / "runs" / stamp)
    if not out.is_absolute():
        out = ROOT / out
    out.mkdir(parents=True, exist_ok=True)
    private_support(out)
    version = nsh_version()
    rows = doctor()
    if doctor_failed(rows):
        rows.extend(skipped("not run because doctor failed"))
        rows.extend(pending_rows())
        return write_summary(out, rows, version, load_start)
    built = build(out / "build.log")
    rows.append(built)
    if built["status"] == "fail":
        rows.extend(skipped("not run because the release build failed"))
        rows.extend(pending_rows())
        return write_summary(out, rows, version, load_start)
    if args.subset == "cache":
        rows.extend(cache_subset(out))
        return write_summary(out, rows, version, load_start)
    if args.subset == "alpha":
        tool = compile_window_id(out)
        rows.extend(run_alpha(out, tool))
        code = write_summary(out, rows, version, load_start)
        alpha_dir = ROOT / "docs" / "verify" / "alpha"
        alpha_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy(out / "summary.json", alpha_dir / "summary.json")
        return code
    if args.subset == "preflight":
        tool = compile_window_id(out)
        try:
            rows.extend(run_form_fixture(out, tool))
        except Exception as exc:
            rows.append(check("shell-form-fixture", "shell", "window", "fail", str(exc)))
        return write_summary(out, rows, version, load_start)
    if args.subset == "shelf":
        try:
            rows.extend(row for row in run_nsh(out) if str(row["id"]).startswith("shelf-"))
        except subprocess.TimeoutExpired:
            rows.append(check("shelf-empty", "library-shelf", "nsh", "fail", "nsh test timed out"))
        tool = compile_window_id(out)
        try:
            rows.extend(run_shelf_windows(out, tool))
        except Exception as exc:
            rows.append(check("shelf-window-epub", "library-shelf", "window", "fail", str(exc)))
        try:
            rows.extend(run_smoke(out, tool))
        except Exception as exc:
            rows.append(check("smoke-launch", "smoke", "window", "fail", str(exc)))
        code = write_summary(out, rows, version, load_start)
        shelf_dir = ROOT / "docs" / "verify" / "shelf"
        shelf_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy(out / "summary.json", shelf_dir / "summary.json")
        for png in out.glob("shelf-*.png"):
            shutil.copy(png, shelf_dir / png.name)
        return code
    try:
        rows.extend(run_nsh(out))
    except subprocess.TimeoutExpired:
        rows.append(check("nsh-title", "reading-bars", "nsh", "fail", "nsh test timed out"))
    try:
        tool = compile_window_id(out)
        ocr_tool = compile_ocr(out)
        rows.extend(run_windows(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("pdf-title", "open-a-pdf", "window", "fail", str(exc)))
    try:
        rows.extend(run_reading(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("trim-32kai-pride", "reading-view", "window", "fail", str(exc)))
    try:
        rows.extend(run_chrome(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("chrome-b-aspect", "window-chrome", "window", "fail", str(exc)))
    try:
        rows.extend(run_aqua(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("window-aqua", "window-chrome", "window", "fail", str(exc)))
        rows.append(check("window-aqua-light", "window-chrome", "window", "fail", str(exc)))
    try:
        rows.extend(run_flash(out, tool))
    except Exception as exc:
        rows.append(check("flash-pride", "window-chrome", "window", "fail", str(exc)))
    try:
        rows.extend(run_bar(out, tool))
    except Exception as exc:
        rows.append(check("sidebar-centered", "sidebar", "window", "fail", str(exc)))
    rows.extend(run_measure(out))
    try:
        rows.extend(bold_word_starts(out, tool))
    except Exception as exc:
        rows.append(check("bold-word-starts-off", "bold-word-starts", "window", "fail", str(exc)))
    try:
        rows.append(bold_break_cache(out))
    except Exception as exc:
        rows.append(check("bold-word-starts-cache", "bold-word-starts", "window", "fail", str(exc)))
    try:
        rows.extend(run_system_open(out))
    except Exception as exc:
        rows.append(check("open-cold-epub", "official-open", "window", "fail", str(exc)))
    try:
        rows.extend(run_alpha(out, tool))
    except Exception as exc:
        rows.append(check("alpha-empty", "alpha", "window", "fail", str(exc)))
    try:
        rows.extend(run_form_fixture(out, tool))
    except Exception as exc:
        rows.append(check("shell-form-fixture", "shell", "window", "fail", str(exc)))
        rows.append(check("shell-form-parity", "shell", "window", "fail", str(exc)))
    rows.append(check("smoke-shell-click", "smoke", "window", "pending", SHELL_CLICK_GAP))
    rows.extend(pending_rows())
    head = git_head()
    rows.append(
        check(
            "verified-head",
            "doctor",
            "none",
            "pass" if len(head) == 40 else "fail",
            head or "git rev-parse HEAD was empty",
        )
    )
    summary_path = write_summary(out, rows, version, load_start)
    alpha_dir = ROOT / "docs" / "verify" / "alpha"
    alpha_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy(out / "summary.json", alpha_dir / "summary.json")
    return summary_path


FINDER_GAP = (
    "The packaged app accepts EPUB and PDF through application:openURLs:. "
    "This driver does not perform the Finder double-click, so the check stays pending."
)

OPENS_LOG = Path("/tmp/superreader-spike/opens.log")
OPEN_IDS = ("open-cold-epub", "open-running-pdf", "open-dock-equivalent")
READER_PROFILE = Path.home() / "Library/Application Support/app.slowpage.reader"


def slowpage_pids():
    proc = subprocess.run(["pgrep", "-x", "Slowpage"], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    return [int(line) for line in proc.stdout.split() if line.strip()]


def stop_pids(pids):
    for pid in pids:
        subprocess.run(["kill", str(pid)], check=False)


def opens_log_has(path):
    name = Path(path).name
    try:
        lines = OPENS_LOG.read_text().splitlines()
    except OSError:
        return False
    return any(line.startswith("queued ") and line.rsplit("/", 1)[-1] == name for line in lines)


def wait_for_open(path, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if opens_log_has(path):
            return True
        time.sleep(0.4)
    return False


def package_app(dest_dir, support):
    dest_dir.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    env["SR_APP_DIR"] = str(dest_dir)
    env["SR_SUPPORT_DIR"] = str(support)
    proc = subprocess.run(
        ["scripts/package-macos.sh"],
        cwd=ROOT,
        env=env,
        capture_output=True,
        text=True,
    )
    return proc, dest_dir / "Slowpage.app"


def run_system_open(out):
    rows = []
    if slowpage_pids():
        for check_id in OPEN_IDS:
            rows.append(
                check(
                    check_id,
                    "official-open",
                    "window",
                    "fail",
                    "Slowpage is already running",
                )
            )
        return rows
    if not PRIDE.is_file() or not GPT3.is_file():
        for check_id in OPEN_IDS:
            rows.append(
                check(
                    check_id,
                    "official-open",
                    "window",
                    "fail",
                    f"missing {PRIDE} or {GPT3}",
                )
            )
        return rows
    support = Path(tempfile.mkdtemp(prefix=f"superreader-open-{out.name}-"))
    require_isolated_support({"SUPERREADER_SUPPORT_DIR": str(support)})
    packaged, app = package_app(out / "package", support)
    if packaged.returncode != 0 or not app.is_dir():
        detail = (packaged.stderr or packaged.stdout or "package-macos.sh failed").strip()
        for check_id in OPEN_IDS:
            rows.append(check(check_id, "official-open", "window", "fail", detail[-400:]))
        return rows
    dock = out / "dock-drop.epub"
    shutil.copy(PRIDE, dock)
    OPENS_LOG.parent.mkdir(parents=True, exist_ok=True)
    OPENS_LOG.unlink(missing_ok=True)
    started = []
    try:
        subprocess.run(["open", "-a", str(app), str(PRIDE)], check=False)
        started = slowpage_pids()
        cold_ok = wait_for_open(PRIDE, 25)
        rows.append(
            check(
                "open-cold-epub",
                "official-open",
                "window",
                "pass" if cold_ok else "fail",
                f"queued {PRIDE}" if cold_ok else "opens.log has no cold EPUB",
                str(OPENS_LOG) if cold_ok else None,
            )
        )
        if not started:
            for check_id in OPEN_IDS[1:]:
                rows.append(
                    check(
                        check_id,
                        "official-open",
                        "window",
                        "fail",
                        "Slowpage did not stay up after open -a",
                    )
                )
            return rows
        subprocess.run(["open", "-a", str(app), str(GPT3)], check=False)
        pdf_ok = wait_for_open(GPT3, 25)
        rows.append(
            check(
                "open-running-pdf",
                "official-open",
                "window",
                "pass" if pdf_ok else "fail",
                f"queued {GPT3}" if pdf_ok else "opens.log has no running PDF",
                str(OPENS_LOG) if pdf_ok else None,
            )
        )
        subprocess.run(["open", "-a", str(app), str(dock)], check=False)
        dock_ok = wait_for_open(dock, 25)
        rows.append(
            check(
                "open-dock-equivalent",
                "official-open",
                "window",
                "pass" if dock_ok else "fail",
                (
                    f"queued {dock} via open -a while running. "
                    "That is the Launch Services path a Dock drop uses. "
                    "The script does not drag onto the Dock icon."
                )
                if dock_ok
                else "opens.log has no dock-equivalent EPUB",
                str(OPENS_LOG) if dock_ok else None,
            )
        )
    finally:
        stop_pids(started or slowpage_pids())
    return rows


def app_binary(app):
    macos = Path(app) / "Contents" / "MacOS"
    files = [path for path in macos.iterdir() if path.is_file() and not path.name.startswith(".")]
    if not files:
        raise RuntimeError("Slowpage.app has no executable")
    return files[0]


def product_env(support):
    env = child_env({})
    env["SUPERREADER_SUPPORT_DIR"] = str(support)
    return env


def menu_open(pid, path):
    click = f'''
tell application "System Events"
  set proc to first process whose unix id is {pid}
  set frontmost of proc to true
  delay 0.5
  click menu item "Open…" of menu "File" of menu bar item "File" of menu bar 1 of proc
end tell
'''
    proc = subprocess.run(["osascript", "-e", click], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "Open menu failed")
    time.sleep(0.7)
    go = f'''
tell application "System Events"
  keystroke "g" using {{command down, shift down}}
  delay 0.4
  keystroke "{path}"
  delay 0.2
  keystroke return
  delay 0.6
  keystroke return
end tell
'''
    proc = subprocess.run(["osascript", "-e", go], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "open panel failed")


def reader_pdf_page():
    path = Path("/tmp/superreader-spike/reader.json")
    try:
        body = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if body.get("mode") != "pdf":
        return None
    page = body.get("page")
    if isinstance(page, int) and page > 0:
        return page
    return None


def webkit_page():
    try:
        body = json.loads(WEBKIT_JSON.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    pages = body.get("pages")
    if isinstance(pages, list) and len(pages) == 2:
        return int(pages[0])
    return None


def wait_until(predicate, timeout):
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        last = predicate()
        if last:
            return last
        time.sleep(0.4)
    return last


def shoot(window_tool, pid, path):
    wid = window_id(window_tool, pid)
    if wid:
        capture(wid, path)


def run_alpha(out, window_tool):
    rows = []
    shot_dir = ROOT / "docs" / "verify" / "alpha"
    shot_dir.mkdir(parents=True, exist_ok=True)
    ids = (
        "alpha-empty",
        "alpha-epub-open",
        "alpha-epub-turn",
        "alpha-epub-reopen",
        "alpha-pdf-open",
        "alpha-pdf-turn",
        "alpha-pdf-reopen",
    )
    support_root = Path(tempfile.mkdtemp(prefix=f"superreader-alpha-{out.name}-"))
    require_isolated_support({"SUPERREADER_SUPPORT_DIR": str(support_root)})
    packaged, app = package_app(out / "app", support_root)
    if packaged.returncode != 0 or not app.is_dir():
        detail = (packaged.stderr or packaged.stdout or "package-macos.sh failed").strip()
        for check_id in ids:
            rows.append(check(check_id, "alpha", "window", "fail", detail[-400:]))
        rows.append(check("alpha-finder-open", "alpha", "none", "pending", FINDER_GAP))
        return rows
    binary = app_binary(app)

    def drive(kind, book, ready, shot_name):
        support = out / f"alpha-support-{kind}"
        shutil.rmtree(support, ignore_errors=True)
        support.mkdir()
        if WEBKIT_JSON.exists() and kind == "epub":
            WEBKIT_JSON.unlink()
        state = launch(
            out,
            f"alpha-{kind}",
            product_env(support),
            lambda names: any(name == "Open" for name in names),
            25,
            binary=binary,
        )
        if not state["alive"]:
            raise RuntimeError(f"{kind} app exited before the empty window")
        empty_shot = shot_dir / f"{shot_name}-empty.png" if kind == "epub" else None
        if empty_shot:
            shoot(window_tool, state["pid"], empty_shot)
        opened = any(name == "Open" for name in state["names"])
        menu_open(state["pid"], book)
        shown = wait_until(ready, 40)
        page_shot = shot_dir / f"{shot_name}.png"
        shoot(window_tool, state["pid"], page_shot)
        subprocess.run(
            ["osascript", "-e", f'tell application "System Events" to set frontmost of (first process whose unix id is {state["pid"]}) to true'],
            capture_output=True,
            text=True,
        )
        subprocess.run(
            ["osascript", "-e", 'tell application "System Events" to key code 124'],
            capture_output=True,
            text=True,
        )
        turned = wait_until(lambda: ready() == 2 or ready() is True and False, 20)
        # ready() returns the page number when the book is showing.
        page_after = None
        deadline = time.time() + 25
        while time.time() < deadline:
            page_after = ready()
            if isinstance(page_after, int) and page_after >= 2:
                break
            time.sleep(0.4)
        names_now, _dump = ax_names(state["pid"])
        surface = reading_surface(
            names_now,
            page_after if kind == "epub" and isinstance(page_after, int) else None,
            page_after if kind == "pdf" and isinstance(page_after, int) else None,
        )
        finish_launch(state)
        time.sleep(0.6)
        if kind == "epub" and WEBKIT_JSON.exists():
            WEBKIT_JSON.unlink()
        again = launch(
            out,
            f"alpha-{kind}-again",
            product_env(support),
            lambda names: True,
            8,
            binary=binary,
        )
        restored = None
        deadline = time.time() + 40
        while time.time() < deadline:
            restored = ready()
            if isinstance(restored, int) and restored >= 2:
                break
            time.sleep(0.4)
        finish_launch(again)
        return opened, shown, page_after, restored, surface

    try:
        pride = os.environ.get("SPIKE_PRIDE", "/tmp/superreader-fixtures/pride-se.epub")
        pdf = os.environ.get("SPIKE_GPT3", "/tmp/superreader-fixtures/gpt3.pdf")
        opened, shown, turned, restored, surface = drive(
            "epub",
            pride,
            webkit_page,
            "epub",
        )
        # S1 removed the Open button and said not to repair that flow. The shelf
        # window is the empty state. An Open button here is the old window.
        empty_ok = not opened
        rows.append(check(
            "alpha-empty",
            "alpha",
            "window",
            "pass" if empty_ok else "fail",
            "shelf window has no Open button" if empty_ok else "Open button returned",
            "empty.png",
        ))
        rows.extend(alpha_page_rows("epub", surface, shown, turned, restored))
        support = out / "alpha-support-pdf"
        shutil.rmtree(support, ignore_errors=True)
        support.mkdir()
        state = launch(out, "alpha-pdf", product_env(support), lambda names: any(name == "Open" for name in names), 25, binary=binary)
        menu_open(state["pid"], pdf)
        def current_pdf():
            names, _dump = ax_names(state["pid"])
            # reader.json is internal. It cannot stand in for a page on screen.
            return displayed_pdf_page(names), names
        first = None
        pdf_names = []
        deadline = time.time() + 40
        while time.time() < deadline:
            first, pdf_names = current_pdf()
            if first == 1:
                break
            time.sleep(0.4)
        shoot(window_tool, state["pid"], shot_dir / "pdf.png")
        subprocess.run(["osascript", "-e", f'tell application "System Events" to set frontmost of (first process whose unix id is {state["pid"]}) to true'], capture_output=True, text=True)
        subprocess.run(["osascript", "-e", 'tell application "System Events" to key code 124'], capture_output=True, text=True)
        second = None
        deadline = time.time() + 20
        while time.time() < deadline:
            second, pdf_names = current_pdf()
            if isinstance(second, int) and second >= 2:
                break
            time.sleep(0.4)
        finish_launch(state)
        time.sleep(0.6)
        again = launch(out, "alpha-pdf-again", product_env(support), lambda names: True, 8, binary=binary)
        def current_again():
            names, _dump = ax_names(again["pid"])
            return displayed_pdf_page(names)
        back = None
        deadline = time.time() + 40
        while time.time() < deadline:
            back = current_again()
            if isinstance(back, int) and back >= 2:
                break
            time.sleep(0.4)
        finish_launch(again)
        pdf_surface = reading_surface(pdf_names, None, first if isinstance(first, int) else None)
        internal = reader_pdf_page()
        pdf_rows = alpha_page_rows("pdf", pdf_surface, first, second, back)
        if pdf_surface != "book_loaded" and internal:
            for row in pdf_rows:
                row["detail"] += f"; reader.json page {internal} is internal and was not on screen"
        rows.extend(pdf_rows)
    except Exception as exc:
        rows.append(check("alpha-empty", "alpha", "window", "fail", str(exc)))
    rows.append(check("alpha-finder-open", "alpha", "none", "pending", FINDER_GAP))
    for name in ("empty.png", "epub.png", "pdf.png"):
        source = shot_dir / name
        if not source.exists():
            alt = shot_dir / "epub-empty.png"
            if name == "empty.png" and alt.exists():
                shutil.copy(alt, source)
    return rows


if __name__ == "__main__":
    sys.exit(main())
