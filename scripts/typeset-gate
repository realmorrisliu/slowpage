#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SPIKES = ROOT / "spikes"
SHELL_BIN = SPIKES / "target" / "release" / "spike-shell"
GATE_BIN = ROOT / "crates" / "superreader-typeset" / "target" / "release" / "typeset-gate"
FIXTURES = Path(os.environ.get("SPIKE_FIXTURES", "/tmp/superreader-fixtures"))
PRIDE = Path(os.environ.get("SPIKE_PRIDE", str(FIXTURES / "pride-se.epub")))
ZHAOHUA = Path(os.environ.get("SPIKE_ZHAOHUA", str(FIXTURES / "zhaohua.epub")))
WEBKIT_JSON = Path("/tmp/superreader-spike/webkit.json")
CHROME_JSON = Path("/tmp/superreader-spike/chrome.json")
LOCK = Path("/tmp/superreader-verify.lock")
LOCK_BARE_MAX_AGE = 60.0
OUT = ROOT / "docs" / "design" / "typeset-gate"
SIDES = {
    "pride-343": OUT / "pride-343.png",
    "pride-383": OUT / "pride-383.png",
    "zhaohua-fan": OUT / "zhaohua-fan.png",
}
SIDE = 52.0
TOP = 48.0
CI = "--ci" in sys.argv[1:]
DISPLAY_PROC: subprocess.Popen | None = None
DISPLAY_DONE: Path | None = None
# DOM measure of "acknowledged" on Iowan Old Style at 22px. Recorded in
# docs/design/north-star.md. EB Garamond sets the same word at 119.9px.
IOWAN_ACKNOWLEDGED_22 = 138.4

BASELINE = {
    "column": 343.47,
    "reader_p95": 3.4286,
    "reader_max": 5.4286,
    "owned_p95": 1.2478,
    "owned_max": 1.4799,
    "fallback_p95": 3.5714,
    "fallback_max": 5.4286,
    "source": "bc-498e04f9",
    "commit": "cfe3404",
    "load": 8.9,
    "note": "Recorded baseline, not the bar. Tighten later.",
}


def output_paths() -> tuple[Path, str, dict[str, Path]]:
    if CI:
        out = ROOT / "docs" / "design" / "typeset-gate" / "ci"
        name = "census.json"
    else:
        out = ROOT / "docs" / "design" / "typeset-gate"
        name = "summary.json"
    sides = {
        "pride-343": out / "pride-343.png",
        "pride-383": out / "pride-383.png",
        "zhaohua-fan": out / "zhaohua-fan.png",
    }
    return out, name, sides


def main() -> int:
    global OUT, SIDES
    OUT, summary_name, SIDES = output_paths()
    if any(arg in ("--font-expand", "--letter-space") for arg in sys.argv[1:]):
        print("phase 1 refuses font expansion and letter-spacing", file=sys.stderr)
        return 1
    if sys.platform != "darwin":
        reason = "phase 1 measures the WKWebView reader, so this run needs macOS"
        if CI:
            write_summary(blocked_summary(reason))
            return 0
        print(reason, file=sys.stderr)
        return 2
    host = socket.gethostname()
    if not CI and "morris-mac" in host.lower():
        subprocess.run([str(ROOT / "scripts" / "cleanup-worktrees.sh"), "--apply"], cwd=ROOT, check=False)
    locked = False
    try:
        if CI:
            if shell_running():
                subprocess.run(["pkill", "-x", "spike-shell"], check=False)
                time.sleep(1)
            os.environ["SUPERREADER_SUPPORT_DIR"] = str(OUT / "support")
        else:
            locked = take_lock()
            wait_load()
            wait_shell()
            wait_load()
        if CI:
            iowan = find_font(["Iowan Old Style.ttc", "IowanOldStyle.ttc"])
            songti = find_font(["Songti.ttc", "Songti SC.ttc", "STSongti.ttc"])
            if iowan is None or songti is None:
                write_summary(
                    blocked_summary(
                        "this Mac has no Iowan Old Style or Songti file "
                        f"(iowan={iowan}, songti={songti}). "
                        "The WKWebView reader cannot be measured on those faces.",
                        host,
                        load_average(),
                    )
                )
                return 0
        build()
        load_start = load_average() if CI else wait_load()
        try:
            faces = resolve_faces()
        except SystemExit as err:
            reason = err.code if isinstance(err.code, str) else "could not resolve Iowan Old Style and Songti SC"
            if CI:
                write_summary(blocked_summary(reason, host, load_start))
                return 0
            print(reason, file=sys.stderr)
            return 2
        OUT.mkdir(parents=True, exist_ok=True)
        run_dir = OUT / "run"
        run_dir.mkdir(parents=True, exist_ok=True)
        display = prepare_display(run_dir)
        faces["nsfont"] = probe_nsfonts(run_dir)
        window_tool = compile_window_id(run_dir)
        cases = [
            measure_pride(faces, window_tool, run_dir, 343.47, "pride-343"),
            measure_pride(faces, window_tool, run_dir, 383.78, "pride-383"),
            measure_zhaohua(faces, window_tool, run_dir),
        ]
        blocked = face_blocker(faces)
        passed = all(case.get("ok") for case in cases) and blocked is None
        summary = {
            "phase": 1,
            "ci": CI,
            "runner": "github-hosted-macos" if os.environ.get("GITHUB_ACTIONS") == "true" else host,
            "head": git_head(),
            "github_sha": os.environ.get("GITHUB_SHA") or None,
            "github_run_id": os.environ.get("GITHUB_RUN_ID") or None,
            "github_run_url": github_run_url(),
            "sw_vers": sw_vers(),
            "arch": os.uname().machine,
            "hostname": host,
            "load": load_start,
            "load_end": load_average(),
            "baseline": BASELINE,
            "faces": faces["record"],
            "nsfont": faces["nsfont"],
            "display": display,
            "cases": cases,
            "screenshot": str(SIDES["pride-343"].relative_to(ROOT)),
            "screenshots": [str(path.relative_to(ROOT)) for path in SIDES.values()],
            "blocked": blocked,
            "phase1_pass": passed,
            "ok": passed,
            "note": (
                "Phase 1 pass on this build, fonts, and widths."
                if passed
                else "Not a Phase 1 pass. The 2026-11-10 Iowan baseline is a historical record only. The EPUB default stays WKWebView."
            ),
        }
        write_summary(summary, summary_name)
        return 0 if CI or passed else 1
    finally:
        release_display()
        if locked:
            release_lock()


def write_summary(summary: dict, name: str | None = None) -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    path = OUT / (name or ("census.json" if CI else "summary.json"))
    text = json.dumps(summary, indent=2) + "\n"
    path.write_text(text)
    print(text)


def blocked_summary(reason: str, host: str | None = None, load: float | None = None) -> dict:
    return {
        "phase": 1,
        "ci": CI,
        "runner": "github-hosted-macos" if os.environ.get("GITHUB_ACTIONS") == "true" else (host or socket.gethostname()),
        "head": git_head(),
        "github_sha": os.environ.get("GITHUB_SHA") or None,
        "github_run_id": os.environ.get("GITHUB_RUN_ID") or None,
        "github_run_url": github_run_url(),
        "sw_vers": sw_vers() if sys.platform == "darwin" else None,
        "arch": os.uname().machine,
        "hostname": host or socket.gethostname(),
        "load": load,
        "blocked": reason,
        "cases": [],
        "phase1_pass": False,
        "ok": False,
        "note": "WKWebView census did not run. This is not a Phase 1 pass. The EPUB default stays WKWebView.",
    }


def github_run_url() -> str | None:
    repo = os.environ.get("GITHUB_REPOSITORY")
    run_id = os.environ.get("GITHUB_RUN_ID")
    if not repo or not run_id:
        return None
    return f"https://github.com/{repo}/actions/runs/{run_id}"


def sw_vers() -> str | None:
    proc = subprocess.run(["sw_vers", "-productVersion"], capture_output=True, text=True)
    text = proc.stdout.strip()
    return text or None


def face_blocker(faces: dict) -> str | None:
    nsfont = faces.get("nsfont") or {}
    if nsfont.get("error"):
        return None
    missing = []
    for name in ("Iowan Old Style", "Songti SC"):
        row = nsfont.get(name) or {}
        family = str(row.get("family") or "")
        face = str(row.get("font") or "")
        if name == "Iowan Old Style" and "Iowan" not in family and "Iowan" not in face:
            missing.append(name)
        if name == "Songti SC" and "Songti" not in family and "Songti" not in face and "STSong" not in face and "宋" not in family:
            missing.append(name)
    if not missing:
        return None
    return "NSFont did not resolve " + " and ".join(missing) + " on this Mac"


def shell_running() -> bool:
    proc = subprocess.run(["pgrep", "-x", "spike-shell"], capture_output=True, text=True)
    return proc.returncode == 0 and bool(proc.stdout.strip())


def wait_shell() -> None:
    while shell_running():
        print("waiting for another spike-shell to exit", file=sys.stderr)
        time.sleep(15)


def take_lock() -> bool:
    while True:
        if clear_stale_lock():
            continue
        try:
            LOCK.mkdir()
        except FileExistsError:
            print(f"waiting for verify lock (held by {lock_holder()})", file=sys.stderr)
            time.sleep(30)
            continue
        try:
            (LOCK / "pid").write_text(f"{os.getpid()}\n")
            (LOCK / "branch").write_text(git_branch() + "\n")
            (LOCK / "started").write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + "\n")
        except OSError:
            shutil.rmtree(LOCK, ignore_errors=True)
            time.sleep(1)
            continue
        return True


def release_lock() -> None:
    try:
        holder = (LOCK / "pid").read_text().strip()
    except OSError:
        return
    if holder != str(os.getpid()):
        return
    shutil.rmtree(LOCK, ignore_errors=True)


def clear_stale_lock() -> bool:
    if not LOCK.is_dir():
        return False
    pid_path = LOCK / "pid"
    if not pid_path.is_file():
        age = time.time() - LOCK.stat().st_mtime
        if age < LOCK_BARE_MAX_AGE:
            return False
        print("clearing verify lock without pid metadata (older than 60s)", file=sys.stderr)
        shutil.rmtree(LOCK, ignore_errors=True)
        return not LOCK.exists()
    try:
        holder = int(pid_path.read_text().strip())
    except ValueError:
        return False
    if pid_alive(holder):
        return False
    print(f"clearing stale verify lock (pid {holder})", file=sys.stderr)
    shutil.rmtree(LOCK, ignore_errors=True)
    return not LOCK.exists()


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def lock_holder() -> str:
    def read(name: str) -> str:
        try:
            return (LOCK / name).read_text().strip()
        except OSError:
            return "?"

    return f"pid {read('pid')} branch {read('branch')} since {read('started')}"


def git_branch() -> str:
    proc = subprocess.run(
        ["git", "branch", "--show-current"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    branch = proc.stdout.strip()
    return branch or "unknown"


def load_average() -> float:
    proc = subprocess.run(["sysctl", "-n", "vm.loadavg"], capture_output=True, text=True, check=True)
    token = proc.stdout.strip().strip("{}").split()[0]
    return float(token)


def wait_load() -> float:
    while True:
        load = load_average()
        if load < 8.0:
            print(f"load {load} is under 8", file=sys.stderr)
            return load
        print(f"waiting for load < 8 (now {load})", file=sys.stderr)
        time.sleep(15)


def build() -> None:
    subprocess.run(["cargo", "build", "-p", "spike-shell", "--release"], cwd=SPIKES, check=True)
    subprocess.run(
        ["cargo", "build", "--release", "--bin", "typeset-gate"],
        cwd=ROOT / "crates" / "superreader-typeset",
        check=True,
    )


def git_head() -> str:
    proc = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True, check=True)
    return proc.stdout.strip()


def resolve_faces() -> dict:
    iowan = find_font(["Iowan Old Style.ttc", "IowanOldStyle.ttc"])
    songti = find_font(["Songti.ttc", "Songti SC.ttc", "STSongti.ttc"])
    if iowan is None or songti is None:
        raise SystemExit(f"missing Iowan or Songti (iowan={iowan}, songti={songti})")
    roman = pick_face(iowan, ["iowan"], ["italic", "bold"])
    italic = pick_face(iowan, ["iowan", "italic"], ["bold"])
    song = (
        pick_face(songti, ["songti sc"], ["bold"])
        or pick_face(songti, ["songti"], ["bold", "tc"])
        or pick_face(songti, ["宋體-簡", "標準"], [])
        or pick_face(songti, ["stsong"], [])
    )
    if roman is None or italic is None or song is None:
        raise SystemExit(f"could not pick faces from {iowan} and {songti}")
    return {
        "iowan": iowan,
        "roman": roman,
        "italic": italic,
        "songti": songti,
        "song": song,
        "record": {
            "iowan": f"{iowan}#{roman[0]} {roman[1]}",
            "italic": f"{iowan}#{italic[0]} {italic[1]}",
            "cjk": f"{songti}#{song[0]} {song[1]}",
        },
    }


def find_font(names: list[str]) -> str | None:
    roots = [
        Path("/System/Library/Fonts"),
        Path("/System/Library/Fonts/Supplemental"),
        Path("/Library/Fonts"),
        Path.home() / "Library" / "Fonts",
    ]
    for root in roots:
        for name in names:
            path = root / name
            if path.is_file():
                return str(path)
    return None


def pick_face(path: str, accept: list[str], reject: list[str]) -> tuple[int, str] | None:
    proc = subprocess.run([str(GATE_BIN), "--list-faces", path], capture_output=True, text=True)
    if proc.returncode != 0:
        raise SystemExit(proc.stderr or f"list-faces failed for {path}")
    chosen = None
    for line in proc.stdout.splitlines():
        if "\t" not in line:
            continue
        index, name = line.split("\t", 1)
        low = name.lower()
        if any(word in low for word in reject):
            continue
        if not all(word in low for word in accept):
            continue
        if chosen is None or ("regular" in low and "regular" not in chosen[1].lower()):
            chosen = (int(index), name)
    return chosen


def measure_pride(faces: dict, window_tool: Path, run_dir: Path, target: float, case_id: str) -> dict:
    return measure(
        faces,
        window_tool,
        run_dir,
        case_id,
        {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"},
        PRIDE,
        "chapter-1.xhtml",
        target,
        22.0,
        faces["iowan"],
        faces["roman"][0],
        faces["iowan"],
        faces["italic"][0],
        faces["songti"],
        faces["song"][0],
        require_font=22.0,
    )


def measure_zhaohua(faces: dict, window_tool: Path, run_dir: Path) -> dict:
    return measure(
        faces,
        window_tool,
        run_dir,
        "zhaohua-fan",
        {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "zhaohua"},
        ZHAOHUA,
        "25271-0-1.txt.html",
        372.06,
        20.0,
        faces["iowan"],
        faces["roman"][0],
        faces["iowan"],
        faces["italic"][0],
        faces["songti"],
        faces["song"][0],
        require_font=20.0,
    )


def measure(
    faces,
    window_tool,
    run_dir,
    case_id,
    env_extra,
    epub,
    href,
    target,
    fallback_size,
    latin,
    latin_index,
    italic,
    italic_index,
    cjk,
    cjk_index,
    require_font,
) -> dict:
    state = None
    log_path = run_dir / f"{case_id}-shell.log"
    try:
        env = dict(env_extra)
        body = None
        width_note = None
        maximized = False
        asked: set[str] = set()
        settle_timeout = 45 if CI else 25
        layout_timeout = 90 if CI else 40
        for _ in range(4):
            CHROME_JSON.unlink(missing_ok=True)
            WEBKIT_JSON.unlink(missing_ok=True)
            started = time.time()
            state = launch(env, log_path)
            if not wait_settled(started, env.get("SPIKE_WINDOW"), settle_timeout):
                keep_reader_files(run_dir, case_id)
                stop(state)
                state = None
                return fail(case_id, "reader window did not settle" + log_tail(log_path))
            body = wait_layout(state, layout_timeout, lambda item: layout_ready(item))
            if body is None:
                keep_reader_files(run_dir, case_id)
                alive = state["proc"].poll()
                stop(state)
                state = None
                detail = "reader layout did not settle"
                if alive is not None:
                    detail += f" (spike-shell exited {alive})"
                return fail(case_id, detail + log_tail(log_path))
            if target is None:
                break
            column_now = (body.get("layout") or {}).get("column")
            if isinstance(column_now, (int, float)) and abs(float(column_now) - target) <= 0.5:
                break
            frame = window_for_column(body, target)
            label = None if frame is None else f"{frame[0]:.1f}x{frame[1]:.1f}"
            print(f"{case_id} column {column_now} page {body.get('page_w')} -> window {label}", file=sys.stderr)
            if label is not None and label not in asked:
                asked.add(label)
                stop(state)
                state = None
                env = dict(env_extra)
                env["SPIKE_WINDOW"] = label
                continue
            grown = maximize_window() if not maximized else None
            if grown is not None and grown not in asked:
                maximized = True
                asked.add(grown)
                stop(state)
                state = None
                env = dict(env_extra)
                env["SPIKE_WINDOW"] = grown
                print(f"{case_id} maximize window {grown}", file=sys.stderr)
                continue
            width_note = width_miss_message(column_now, target, body)
            print(width_note, file=sys.stderr)
            break
        else:
            column_now = (body.get("layout") or {}).get("column") if body else None
            width_note = width_miss_message(column_now, target, body)
            print(width_note, file=sys.stderr)
        if state is None or body is None:
            return fail(case_id, width_note or "reader column was not measured")
        layout = body.get("layout") or {}
        column = layout.get("column")
        font_size = layout.get("font_size") or fallback_size
        if not isinstance(column, (int, float)) or column <= 1:
            return fail(case_id, "reader did not report a column")
        if require_font is not None and abs(float(font_size) - require_font) > 0.5:
            return fail(case_id, f"reader font {font_size}px, wanted {require_font}")
        plain = body.get("plain") or ""
        href_now = body.get("href") or ""
        if case_id == "zhaohua-fan" and "范愛農" not in plain:
            return fail(case_id, f"opened {href_now}, not 范愛農")
        crate_href = href_now.rsplit("/", 1)[-1] if href_now else href
        reader_png = run_dir / f"{case_id}-reader.png"
        capture(window_tool, state["pid"], reader_png)
        reader = {
            "gap_p95": layout.get("all_gap_p95"),
            "gap_max": layout.get("all_gap_max"),
            "column": column,
            "font_size": font_size,
            "owned": layout.get("paragraphs_owned"),
            "native": layout.get("paragraphs_native"),
            "all": layout.get("paragraphs_all"),
            "owned_lines": layout.get("owned_lines"),
            "native_lines": layout.get("native_lines"),
            "all_lines": layout.get("all_lines"),
            "owned_gap_p95": layout.get("gap_p95"),
            "owned_gap_max": layout.get("gap_ratio"),
        }
        probe = layout.get("face_probe") or {}
        reader["acknowledged"] = probe.get("acknowledged")
        reader["iowan"] = probe.get("iowan")
        reader["songti"] = probe.get("songti")
        reader["family"] = probe.get("family")
        reader["tofu"] = body.get("tofu")
        reader_path = run_dir / f"{case_id}-reader.json"
        reader_path.write_text(json.dumps(reader, indent=2) + "\n")
        keep_reader_files(run_dir, case_id)
        case_path = run_dir / f"{case_id}.json"
        png = run_dir / f"{case_id}-crate.png"
        side = SIDES.get(case_id)
        cmd = [
            str(GATE_BIN),
            "--epub", str(epub),
            "--href", crate_href,
            "--latin", latin,
            "--latin-index", str(latin_index),
            "--italic", italic,
            "--italic-index", str(italic_index),
            "--cjk", cjk,
            "--cjk-index", str(cjk_index),
            "--measure", f"{float(column):.2f}",
            "--size", f"{float(font_size):.2f}",
            "--reader", str(reader_path),
            "--png", str(png),
            "--repeats", "5",
            "--out", str(case_path),
        ]
        if side is not None and reader_png.exists():
            cmd.extend(["--beside", str(reader_png), "--side", str(side)])
        subprocess.run(cmd, check=False)
        case = json.loads(case_path.read_text()) if case_path.exists() else fail(case_id, "gate wrote no case")
        case["id"] = case_id
        case["target"] = target
        case["reader_href"] = href_now
        if width_note:
            case["ok"] = False
            failures = list(case.get("failures") or [])
            failures.append(width_note)
            case["failures"] = failures
        if target is not None and abs(float(column) - target) > 0.5:
            case["ok"] = False
            extra = case.get("extra") or []
            extra.append(f"target {target}")
            case["extra"] = extra
        for item in face_extras(case_id, layout.get("face_probe") or {}, font_size, body.get("tofu"), faces):
            case["ok"] = False
            extra = case.get("extra") or []
            extra.append(item)
            case["extra"] = extra
        case["acknowledged_px"] = (layout.get("face_probe") or {}).get("acknowledged")
        case["tofu"] = body.get("tofu")
        case["reader_family"] = (layout.get("face_probe") or {}).get("family")
        return case
    finally:
        if state is not None:
            stop(state)


def fail(case_id: str, message: str) -> dict:
    return {"id": case_id, "ok": False, "failures": [message]}


def layout_ready(item: dict) -> bool:
    layout = item.get("layout") or {}
    page = item.get("page_w")
    view = item.get("view_w")
    placed = (
        isinstance(page, (int, float))
        and isinstance(view, (int, float))
        and float(page) > 1
        and abs(float(page) - float(view)) <= 1.5
    )
    return bool(placed and layout.get("ready") and layout.get("tail") == "done" and item.get("href"))


def wait_settled(started: float, window: str | None, timeout: float = 25) -> bool:
    last = None
    stable = 0
    deadline = time.time() + timeout
    while time.time() < deadline:
        fresh = CHROME_JSON.is_file() and CHROME_JSON.stat().st_mtime >= started - 1
        chrome = (read_json(CHROME_JSON) or {}) if fresh else {}
        size = (chrome.get("window_w"), chrome.get("window_h"))
        page = chrome.get("page_w")
        if size[0] and isinstance(page, (int, float)) and float(page) > 1 and size == last:
            stable += 1
            if stable >= 3:
                if window:
                    print(f"window {window} settled at {size[0]}x{size[1]} page {page}", file=sys.stderr)
                return True
        else:
            stable = 0
            last = size if size[0] else None
        time.sleep(0.4)
    print(f"window did not settle at {window or 'the fitted frame'}", file=sys.stderr)
    return False


def parse_window(raw: str | None):
    if not raw or "x" not in raw:
        return None
    width, height = raw.split("x", 1)
    try:
        return (float(width), float(height))
    except ValueError:
        return None


def width_miss_message(column_now, target, body) -> str:
    chrome = read_json(CHROME_JSON) or {}
    page = None if body is None else body.get("page_w")
    visible = ""
    if isinstance(chrome.get("visible_w"), (int, float)) and isinstance(chrome.get("visible_h"), (int, float)):
        visible = f" visible {chrome.get('visible_w')}x{chrome.get('visible_h')}"
    limit = chrome.get("visible_h")
    if not isinstance(limit, (int, float)):
        limit = chrome.get("window_h")
    short = ""
    if isinstance(limit, (int, float)) and float(limit) < 860:
        short = (
            f"; the documented column needs a window about 870pt tall"
            f" and this frame is {float(limit):.0f}pt"
        )
    return (
        f"reader column {column_now} did not reach {target}; "
        f"window {chrome.get('window_w')}x{chrome.get('window_h')}{visible} "
        f"page {page}{short}"
    )


def maximize_window() -> str | None:
    chrome = read_json(CHROME_JSON) or {}
    width = chrome.get("visible_w")
    height = chrome.get("visible_h")
    if not isinstance(width, (int, float)) or not isinstance(height, (int, float)):
        return None
    if float(width) < 200 or float(height) < 200:
        return None
    return f"{float(width):.1f}x{float(height):.1f}"


def prepare_display(run_dir: Path) -> dict | None:
    """Ask the GitHub-hosted Mac for a display tall enough for the documented columns.

    The paperback page keeps its aspect, so a short visible frame caps the
    column. 343.47 / 383.78 / 372.06 need a window about 870pt tall. This does
    not change the reader. If no taller mode exists, the census still measures
    the column the reader actually reached and does not call that a pass.
    """
    if not CI or sys.platform != "darwin":
        return None
    subprocess.run(["defaults", "write", "com.apple.dock", "autohide", "-bool", "true"], check=False)
    subprocess.run(["killall", "Dock"], check=False)
    time.sleep(1)
    vmware = Path("/Library/Application Support/VMware Tools/vmware-resolutionSet")
    if vmware.is_file():
        subprocess.run(["sudo", "-n", str(vmware), "1920", "1200"], check=False)
        time.sleep(2)
    anka = Path("/Library/Application Support/Veertu/Anka/addons/change_res")
    if anka.is_file():
        subprocess.run([str(anka), "1920x1200x32"], check=False)
        time.sleep(2)
    source = run_dir / "display.swift"
    source.write_text(DISPLAY_SWIFT)
    binary = run_dir / "display"
    out = run_dir / "display.json"
    built = subprocess.run(swiftc_cmd() + ["-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if built.returncode != 0:
        note = (built.stderr or "swiftc failed").strip()
        print(note, file=sys.stderr)
        return {"error": note}
    # The mode set by a process that then exits did not reach spike-shell.
    # Hold this process open for the census. The shell also sets the mode itself.
    global DISPLAY_PROC, DISPLAY_DONE
    done = run_dir / "display.json.done"
    done.unlink(missing_ok=True)
    DISPLAY_DONE = done
    proc = subprocess.Popen([str(binary), str(out)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    DISPLAY_PROC = proc
    deadline = time.time() + 20
    while time.time() < deadline and not (out.is_file() and out.stat().st_size > 0):
        if proc.poll() is not None:
            break
        time.sleep(0.2)
    err = ""
    if proc.poll() is not None:
        err = (proc.stderr.read() if proc.stderr is not None else "") or ""
        out_text = proc.stdout.read() if proc.stdout is not None else ""
        if out_text:
            print(out_text, file=sys.stderr)
        if err:
            print(err, file=sys.stderr)
    data = read_json(out)
    if data is None:
        return {"error": err.strip() or "display probe wrote no json", "status": proc.poll()}
    return data


def release_display() -> None:
    global DISPLAY_PROC, DISPLAY_DONE
    if DISPLAY_DONE is not None:
        try:
            DISPLAY_DONE.write_text("done\n")
        except OSError:
            pass
    proc = DISPLAY_PROC
    DISPLAY_PROC = None
    if proc is None or proc.poll() is not None:
        return
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()


DISPLAY_SWIFT = r"""
import AppKit
import CoreGraphics
import Foundation

func shot() -> [String: Any] {
  let screen = NSScreen.main
  let frame = screen?.frame ?? .zero
  let visible = screen?.visibleFrame ?? .zero
  let mode = CGDisplayCopyDisplayMode(CGMainDisplayID())
  return [
    "points_w": Int(frame.width.rounded()),
    "points_h": Int(frame.height.rounded()),
    "visible_w": Int(visible.width.rounded()),
    "visible_h": Int(visible.height.rounded()),
    "scale": screen?.backingScaleFactor ?? 0,
    "mode_w": mode?.width ?? 0,
    "mode_h": mode?.height ?? 0,
    "pixel_w": mode?.pixelWidth ?? 0,
    "pixel_h": mode?.pixelHeight ?? 0,
  ]
}

let outPath = CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : "display.json"
let app = NSApplication.shared
app.setActivationPolicy(.accessory)
let display = CGMainDisplayID()
let before = shot()
let raw = CGDisplayCopyAllDisplayModes(display, nil) as? [CGDisplayMode] ?? []
var modes: [[String: Int]] = []
var best: CGDisplayMode?
var bestScore = 0
for mode in raw {
  modes.append([
    "w": mode.width,
    "h": mode.height,
    "pixel_w": mode.pixelWidth,
    "pixel_h": mode.pixelHeight,
  ])
  if mode.height >= 1080 && mode.width >= 1440 {
    let score = mode.height * 10000 + mode.width
    if score > bestScore {
      best = mode
      bestScore = score
    }
  }
}
if best == nil {
  let current = Int((NSScreen.main?.frame.height ?? 0).rounded())
  for mode in raw where mode.height > current && mode.width >= 1280 {
    let score = mode.height * 10000 + mode.width
    if score > bestScore {
      best = mode
      bestScore = score
    }
  }
}
var status = 0
var setLabel: String? = nil
if let best {
  status = Int(CGDisplaySetDisplayMode(display, best, nil).rawValue)
  setLabel = "\(best.width)x\(best.height)"
  Thread.sleep(forTimeInterval: 2)
}
var payload: [String: Any] = [
  "before": before,
  "after": shot(),
  "modes": modes,
  "status": status,
]
if let setLabel {
  payload["set"] = setLabel
}
do {
  let data = try JSONSerialization.data(withJSONObject: payload, options: [.prettyPrinted, .sortedKeys])
  try data.write(to: URL(fileURLWithPath: outPath))
  if let text = String(data: data, encoding: .utf8) {
    print(text)
  }
} catch {
  fputs("display json failed \(error)\n", stderr)
  exit(1)
}
let done = URL(fileURLWithPath: outPath + ".done")
let deadline = Date().addingTimeInterval(40 * 60)
while Date() < deadline {
  if FileManager.default.fileExists(atPath: done.path) {
    break
  }
  Thread.sleep(forTimeInterval: 0.5)
}
"""


def window_for_column(body: dict, target: float):
    layout = body.get("layout") or {}
    column = layout.get("column")
    chrome = read_json(CHROME_JSON) or {}
    page_w = body.get("page_w") or chrome.get("page_w")
    if not isinstance(column, (int, float)) or float(column) <= 1:
        return None
    if not isinstance(page_w, (int, float)) or float(page_w) <= 1:
        return None
    window_w = float(chrome.get("window_w") or 0)
    window_h = float(chrome.get("window_h") or 0)
    stage_w = float(chrome.get("stage_w") or window_w)
    stage_h = float(chrome.get("stage_h") or window_h)
    ratio_w = float(chrome.get("ratio_w") or 129)
    ratio_h = float(chrome.get("ratio_h") or 198)
    side = float(chrome.get("side") or SIDE)
    top = float(chrome.get("top") or TOP)
    share = float(column) / float(page_w)
    if abs(share - 0.72) <= 0.04:
        share = 0.72
    page = round(float(target) / share)
    extra_w = window_w - stage_w
    extra_h = window_h - stage_h
    width = max(200.0, page + side * 2 + extra_w)
    height = max(200.0, page * ratio_h / max(ratio_w, 1) + top + extra_h + 4.0)
    return (round(width), round(height))


def launch(extra: dict, log_path: Path | None = None) -> dict:
    env = os.environ.copy()
    for key in list(env):
        if key.startswith("SPIKE_"):
            env.pop(key, None)
    env.update(extra)
    if CI and sys.platform == "darwin":
        env["SPIKE_DISPLAY"] = "1"
    log = open(log_path, "a") if log_path is not None else subprocess.DEVNULL
    proc = subprocess.Popen(
        [str(SHELL_BIN)],
        env=env,
        cwd=SPIKES,
        stdout=log,
        stderr=subprocess.STDOUT if log_path is not None else log,
    )
    if log_path is not None:
        subprocess.run(
            [
                "osascript",
                "-e",
                f'tell application "System Events" to set frontmost of first process whose unix id is {proc.pid} to true',
            ],
            capture_output=True,
            text=True,
        )
    return {"pid": proc.pid, "proc": proc, "log": None if log_path is None else log}


def wait_layout(state, timeout, ready):
    deadline = time.time() + timeout
    last = None
    stable = 0
    while time.time() < deadline:
        if state["proc"].poll() is not None:
            return None
        body = read_json(WEBKIT_JSON)
        mark = None
        if body and ready(body):
            mark = ((body.get("layout") or {}).get("column"), body.get("href"))
        if mark is not None and mark == last:
            stable += 1
            if stable >= 2:
                return body
        else:
            stable = 0
            last = mark
        time.sleep(0.4)
    return None


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def stop(state) -> None:
    proc = state["proc"] if isinstance(state, dict) else state
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=3)
    log = state.get("log") if isinstance(state, dict) else None
    if log is not None:
        log.close()


def face_extras(case_id: str, probe: dict, font_size, tofu, faces: dict) -> list[str]:
    extras = []
    if case_id.startswith("pride"):
        width = probe.get("acknowledged")
        if not isinstance(width, (int, float)):
            extras.append("reader did not report the Iowan word width")
        else:
            expected = IOWAN_ACKNOWLEDGED_22 * (float(font_size) / 22.0)
            if abs(float(width) - expected) > 6.0:
                extras.append(
                    f"acknowledged {float(width):.1f}px, Iowan at {float(font_size):.0f}px is {expected:.1f}px"
                )
    if case_id == "zhaohua-fan" and isinstance(tofu, (int, float)) and int(tofu) > 0:
        extras.append(f"tofu {int(tofu)}")
    return extras


def keep_reader_files(run_dir: Path, case_id: str) -> None:
    for source, name in ((WEBKIT_JSON, "webkit"), (CHROME_JSON, "chrome")):
        if source.is_file():
            shutil.copy(source, run_dir / f"{case_id}-{name}.json")


def log_tail(path: Path) -> str:
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return ""
    tail = [line for line in lines[-12:] if line.strip()]
    if not tail:
        return ""
    return " | " + " | ".join(tail)


def probe_nsfonts(out: Path) -> dict:
    source = out / "nsfont.swift"
    source.write_text(
        """
import AppKit
let names = ["Iowan Old Style", "Songti SC"]
for name in names {
  if let font = NSFont(name: name, size: 22) {
    print("\\(name)\\t\\(font.familyName ?? "")\\t\\(font.fontName ?? "")")
  } else {
    print("\\(name)\\t\\t")
  }
}
"""
    )
    binary = out / "nsfont"
    proc = subprocess.run(swiftc_cmd() + ["-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if proc.returncode != 0:
        return {"error": (proc.stderr or "swiftc failed").strip()}
    ran = subprocess.run([str(binary)], capture_output=True, text=True)
    if ran.returncode != 0:
        return {"error": (ran.stderr or "nsfont probe failed").strip()}
    found = {}
    for line in ran.stdout.splitlines():
        name, family, face = (line.split("\t") + ["", ""])[:3]
        found[name] = {"family": family, "font": face}
    return found


def swiftc_cmd() -> list[str]:
    if shutil.which("swiftc"):
        return ["swiftc"]
    return ["xcrun", "--sdk", "macosx", "swiftc"]


def compile_window_id(out: Path) -> Path:
    source = out / "window-id.swift"
    source.write_text(
        """
import CoreGraphics
import AppKit
guard CommandLine.arguments.count > 1, let pid = Int32(CommandLine.arguments[1]) else { exit(2) }
let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as! [[String: Any]]
var bestArea: CGFloat = 0
var best = ""
for window in info {
  let owner = window[kCGWindowOwnerPID as String] as? Int32 ?? -1
  let layer = window[kCGWindowLayer as String] as? Int ?? -1
  guard owner == pid, layer == 0, let dict = window[kCGWindowBounds as String] as? [String: CGFloat] else { continue }
  let width = dict["Width"] ?? 0
  let height = dict["Height"] ?? 0
  let area = width * height
  if area <= bestArea { continue }
  bestArea = area
  let number = window[kCGWindowNumber as String] as? Int ?? 0
  best = "\\(number)"
}
if best.isEmpty { exit(1) }
print(best)
"""
    )
    binary = out / "window-id"
    proc = subprocess.run(swiftc_cmd() + ["-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "swiftc failed")
    return binary


def capture(tool: Path, pid: int, path: Path) -> None:
    proc = subprocess.run([str(tool), str(pid)], capture_output=True, text=True)
    if proc.returncode != 0:
        return
    window = proc.stdout.strip().split()[0]
    subprocess.run(["screencapture", "-l", window, "-o", str(path)], capture_output=True, text=True)


if __name__ == "__main__":
    sys.exit(main())
